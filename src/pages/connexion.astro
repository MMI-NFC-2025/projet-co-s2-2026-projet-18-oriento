---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Connexion — Oriento" heroSection={false}>
    <div class="auth-page">
        <div class="auth-hero">
            <h1 class="auth-titre">Connexion</h1>
            <div class="auth-vague">
                <svg
                    viewBox="0 0 400 60"
                    xmlns="http://www.w3.org/2000/svg"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <path
                        d="M0,30 Q100,0 200,30 Q300,60 400,30 L400,60 L0,60 Z"
                        fill="var(--color-blue-light)"></path>
                </svg>
            </div>
        </div>

        <div class="auth-body">
            <div class="auth-card">
                <p class="form-succes" id="form-succes" hidden>
                    ✓ Inscription réussie ! Connecte-toi maintenant.
                </p>
                <p class="form-erreur" id="form-erreur" role="alert" hidden></p>

                <form class="auth-form" id="connexion-form" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="email">Email</label>
                        <input
                            class="form-input"
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Votre mail"
                            autocomplete="email"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="password">
                            Mot de passe
                        </label>
                        <input
                            class="form-input"
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Votre mot de passe"
                            autocomplete="current-password"
                            required
                        />
                    </div>
                    <button class="auth-btn" type="submit" id="auth-btn">
                        Se connecter
                    </button>
                </form>
            </div>
            <p class="auth-switch">
                Pas encore de compte ? <a href="/inscription">S'inscrire</a>
            </p>
        </div>
    </div>

    <style>
        .auth-page {
            background: var(--color-blue-light);
            min-height: calc(100svh - 5rem);
            display: flex;
            flex-direction: column;
        }
        .auth-hero {
            background: var(--color-yellow);
            position: relative;
            padding: var(--space-2xl) var(--space-l) 0;
        }
        .auth-titre {
            font-family: var(--font-body);
            font-size: clamp(var(--text-4xl), 12vw, var(--text-6xl));
            font-weight: var(--weight-black);
            color: var(--color-dark);
            line-height: 1.05;
            -webkit-font-smoothing: auto;
            padding-bottom: var(--space-xl);
        }
        .auth-vague {
            width: 100%;
            line-height: 0;
            margin-bottom: -1px;
        }
        .auth-vague svg {
            width: 100%;
            height: 60px;
        }
        .auth-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: var(--space-xl) var(--space-sm) var(--space-2xl);
            gap: var(--space-l);
        }
        .auth-card {
            width: 100%;
            max-width: 360px;
            background: var(--color-white);
            border-radius: var(--radius-l);
            padding: var(--space-xl) var(--space-l);
            box-shadow: var(--shadow-m);
        }
        .auth-form {
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
        }
        .form-label {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-medium);
            color: var(--color-dark);
        }
        .form-input {
            width: 100%;
            background: var(--color-surface, #f0f2ff);
            border: none;
            border-radius: var(--radius-m);
            padding: var(--space-m);
            font-family: var(--font-body);
            font-size: var(--text-sm);
            color: var(--color-dark);
            outline: none;
            transition: box-shadow 0.2s;
        }
        .form-input::placeholder {
            color: #b0b0b0;
        }
        .form-input:focus {
            box-shadow: 0 0 0 2px var(--color-yellow);
        }
        .auth-btn {
            width: 100%;
            margin-top: var(--space-s);
            background: var(--color-yellow);
            color: var(--color-dark);
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-bold);
            border: none;
            border-radius: var(--radius-m);
            padding: var(--space-m);
            cursor: pointer;
            transition:
                opacity 0.2s,
                transform 0.15s;
        }
        .auth-btn:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }
        .auth-btn:active {
            transform: translateY(0);
        }
        .auth-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        .form-erreur {
            font-size: var(--text-sm);
            color: #e53e3e;
            background: #fff5f5;
            border-radius: var(--radius-s);
            padding: var(--space-s) var(--space-m);
            margin-bottom: var(--space-s);
            text-align: center;
        }
        .form-succes {
            font-size: var(--text-sm);
            color: #276749;
            background: #f0fff4;
            border-radius: var(--radius-s);
            padding: var(--space-s) var(--space-m);
            margin-bottom: var(--space-s);
            text-align: center;
        }
        .form-erreur[hidden],
        .form-succes[hidden] {
            display: none;
        }
        .auth-switch {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            color: var(--color-white);
            text-align: center;
        }
        .auth-switch a {
            color: var(--color-yellow);
            font-weight: var(--weight-bold);
            text-decoration: none;
        }
        .auth-switch a:hover {
            text-decoration: underline;
        }
    </style>
</Layout>

<script>
    import { connecterUtilisateur } from "../js/backend.js";

    const form = document.getElementById("connexion-form") as HTMLFormElement;
    const erreurEl = document.getElementById("form-erreur")!;
    const succesEl = document.getElementById("form-succes")!;
    const btn = document.getElementById("auth-btn") as HTMLButtonElement;

    // Affiche le message de succès si on vient de s'inscrire
    const params = new URLSearchParams(window.location.search);
    if (params.get("inscrit") === "1") {
        succesEl.removeAttribute("hidden");
    }

    function afficherErreur(msg: string) {
        erreurEl.textContent = msg;
        erreurEl.removeAttribute("hidden");
        succesEl.setAttribute("hidden", "");
    }

    function cacherErreur() {
        erreurEl.setAttribute("hidden", "");
        erreurEl.textContent = "";
    }

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        cacherErreur();

        const email = (
            form.querySelector("#email") as HTMLInputElement
        ).value.trim();
        const password = (form.querySelector("#password") as HTMLInputElement)
            .value;

        if (!email || !password) {
            afficherErreur("Email et mot de passe sont obligatoires.");
            return;
        }

        btn.disabled = true;
        btn.textContent = "Connexion en cours...";

        try {
            await connecterUtilisateur({ email, password });
            window.location.href = "/";
        } catch (err: any) {
            let msg = "Email ou mot de passe incorrect.";
            if (err?.status === 400) {
                msg = "Email ou mot de passe incorrect.";
            } else if (err?.message) {
                msg = err.message;
            }
            afficherErreur(msg);
        } finally {
            btn.disabled = false;
            btn.textContent = "Se connecter";
        }
    });
</script>
