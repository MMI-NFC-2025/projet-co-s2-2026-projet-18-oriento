---
import Layout from "../layouts/Layout.astro";
import CardHero from "../components/CardHero.astro";
import CardAccueil from "../components/CardAccueil.astro";
import BtnAide from "../components/BtnAide.astro";
import homeImg1 from "../assets/Oriento_img/Home_img1.avif";
import homeImg2 from "../assets/Oriento_img/Home_img2.png";
import logoCompletBlanc from "../assets/Oriento_img/logo_complet_blanc.avif";

const services = [
	{
		href: "/etudes",
		lettre: "É",
		titre: "Études",
		texte: "Comprends les différentes filières, les admissions et les aides disponibles pour financer ta formation.",
		symbole: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
	},
	{
		href: "/logement",
		lettre: "L",
		titre: "Logement",
		texte: "CROUS, colocation, résidence privée… Trouve la solution adaptée à ton budget et ta ville.",
		symbole: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
	},
	{
		href: "/assurance",
		lettre: "A",
		titre: "Assurance",
		texte: "Mutuelle, assurance habitation, responsabilité civile… On t'explique ce qui est obligatoire et comment choisir.",
		symbole: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
	},
	{
		href: "/impots",
		lettre: "I",
		titre: "Impôts",
		texte: "Première déclaration, crédits d'impôt, exonérations étudiantes… On démystifie tout pour toi.",
		symbole: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
	},
];
---

<Layout title="Oriento — Ton guide étudiant" heroSection={true}>
	<div class="page-wrapper">
		<!-- HERO -->
		<section class="hero-section" aria-label="Présentation">
			<div class="hero-inner">
				<div class="hero-logo-wrap">
					<img
						src={logoCompletBlanc.src}
						alt="Oriento"
						width="800"
						height="250"
						class="hero-logo-img"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
				<div class="hero-img-wrap">
					<img
						src={homeImg1.src}
						alt="Étudiant gérant ses démarches"
						width="900"
						height="600"
						class="hero-img"
						loading="eager"
						fetchpriority="high"
					/>
					<h1 class="hero-card-overlay">
						<CardHero
							quote="Avec Oriento les démarches deviennent plus simples"
						/>
					</h1>
				</div>
			</div>
		</section>

		<!-- CARDS SECTION -->
		<section class="cards-section" aria-label="Thématiques">
			<div class="card-section card-section--left">
				<h2 class="card-section__title">
					Démarches administra...? Quesako ?
				</h2>
				<p class="card-section__text">
					Pas de panique ! Oriento est là pour vous aider à y voir
					plus clair
				</p>
			</div>
			<div class="card-section card-section--right">
				<h2 class="card-section__title">
					Des centaines de ressources pédagogiques !
				</h2>
				<p class="card-section__text">
					Pour enfin se réconcilier avec l'administratif
				</p>
			</div>
		</section>

		<!-- NOS SERVICES -->
		<section class="services-section" aria-label="Nos services">
			<div class="services-titre-wrap">
				<p class="services-titre">Nos Services</p>
			</div>
			<div class="services-grid">
				{
					services.map((s) => (
						<a
							href={s.href}
							class="card-link"
							aria-label={`Consulter la rubrique ${s.titre}`}
						>
							<CardAccueil
								lettre={s.lettre}
								titre={s.titre}
								texte={s.texte}
								symbole={s.symbole}
							/>
						</a>
					))
				}
			</div>
		</section>

		<!-- BESOIN D'AIDE -->
		<section class="aide-section" aria-label="Besoin d'aide">
			<h2 class="aide-titre">Besoin<br />d'aide ?</h2>
			<img
				src={homeImg2.src}
				alt="Étudiants collaborant sur leurs démarches"
				width="900"
				height="600"
				class="aide-img"
				loading="lazy"
			/>
		</section>

		<!-- CONTENU EXCLUSIF -->
		<section class="exclu-section" aria-label="Contenu exclusif">
			<div class="exclu-wrap">
				<div class="exclu-media-card">
					<p class="exclu-media-titre">
						Accès à du contenu explicatif
					</p>
					<div class="exclu-media-screen"></div>
				</div>
				<div class="exclu-body">
					<span class="exclu-guillemet" aria-hidden="true">"</span>
					<p class="exclu-texte">
						Une communauté soudée toujours prête à rendre service !
					</p>
					<BtnAide label="Aide" href="/a-propos" />
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-wrapper {
		background: var(--color-blue-light);
	}

	/* ── HERO ── */
	.hero-section {
		background: var(--color-yellow);
		min-height: calc(100svh - 5rem);
		display: flex;
		align-items: stretch;
	}
	.hero-inner {
		width: 100%;
		max-width: 1152px;
		margin: 0 auto;
		padding: var(--space-l) var(--space-sm);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		flex: 1;
		gap: var(--space-sm);
	}
	.hero-logo-wrap {
		width: 100%;
		display: flex;
		justify-content: flex-start;
	}
	.hero-logo-img {
		height: clamp(5rem, 22vw, 9rem);
		width: auto;
	}
	.hero-img-wrap {
		position: relative;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: flex-end;
	}
	.hero-img {
		width: 100%;
		max-width: 480px;
		height: auto;
		object-fit: contain;
		object-position: bottom;
	}
	.hero-card-overlay {
		position: absolute;
		bottom: var(--space-m);
		left: 50%;
		transform: translateX(-50%);
		width: 90%;
		max-width: 420px;
		font-size: 1rem;
		font-weight: 400;
	}

	/* ── CARDS SECTION ── */
	.cards-section {
		padding: var(--space-2xl) 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}
	.card-section {
		background: var(--color-blue);
		color: var(--color-white);
		font-family: var(--font-body);
		padding: var(--space-m) var(--space-l);
		max-width: 600px;
		width: 88%;
	}
	.card-section--left {
		border-radius: 0 var(--radius-l) var(--radius-l) 0;
		margin-right: auto;
	}
	.card-section--right {
		border-radius: var(--radius-l) 0 0 var(--radius-l);
		margin-left: auto;
	}
	.card-section__title {
		font-size: clamp(1.5rem, 5vw, 3rem);
		font-weight: var(--weight-black);
		text-transform: uppercase;
		line-height: 1.05;
		margin-bottom: var(--space-s);
		color: var(--color-white);
		-webkit-font-smoothing: auto;
	}
	.card-section__text {
		font-size: var(--text-m);
		font-weight: var(--weight-bold);
		line-height: 1.5;
		color: var(--color-white);
		-webkit-font-smoothing: auto;
	}

	/* ── SERVICES ── */
	.services-section {
		padding: var(--space-2xl) var(--space-sm);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-xl);
	}
	.services-titre-wrap {
		width: 85%;
		background: var(--color-white);
		border-radius: var(--radius-m);
		box-shadow: var(--shadow-m);
		padding: var(--space-m) var(--space-l);
		text-align: center;
	}
	.services-titre {
		font-family: var(--font-body);
		font-size: clamp(1.875rem, 5vw, 2.25rem);
		font-weight: var(--weight-black);
		text-transform: uppercase;
		color: var(--color-dark);
		letter-spacing: 0.05em;
	}
	.services-grid {
		width: 85%;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-m);
	}
	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: var(--radius-m);
		transition:
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		will-change: transform;
	}
	.card-link:hover {
		transform: translateY(-6px) scale(1.01);
		box-shadow: var(--shadow-xl);
	}
	.card-link:active {
		transform: translateY(-2px) scale(1.005);
		box-shadow: var(--shadow-m);
	}

	/* ── BESOIN D'AIDE ── */
	.aide-section {
		padding: var(--space-2xl) var(--space-sm) 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-l);
	}
	.aide-titre {
		font-family: var(--font-body);
		font-size: clamp(3rem, 18vw, 4.5rem);
		font-weight: var(--weight-black);
		text-transform: uppercase;
		color: var(--color-white);
		line-height: 0.95;
		text-align: center;
		width: 100%;
		-webkit-font-smoothing: auto;
	}
	.aide-img {
		width: 100%;
		max-width: 640px;
		height: auto;
		object-fit: cover;
		border-radius: var(--radius-l) var(--radius-l) 0 0;
	}

	/* ── EXCLUSIF ── */
	.exclu-section {
		padding: var(--space-2xl) var(--space-sm);
		display: flex;
		justify-content: center;
	}
	.exclu-wrap {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-l);
		width: 100%;
	}
	.exclu-media-card {
		background: var(--color-white);
		border: 3px solid var(--color-dark);
		border-radius: 1.5rem;
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		max-width: 300px;
		box-shadow: var(--shadow-l);
	}
	.exclu-media-titre {
		font-family: var(--font-body);
		font-size: var(--text-xl);
		font-weight: var(--weight-black);
		color: var(--color-dark);
		text-align: center;
		line-height: 1.2;
	}
	.exclu-media-screen {
		width: 100%;
		aspect-ratio: 9/14;
		border-radius: 1rem;
		background: #e5e5e5;
	}
	.exclu-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-m);
		width: 100%;
		max-width: 320px;
		padding-bottom: var(--space-m);
	}
	.exclu-guillemet {
		font-family: var(--font-body);
		font-size: var(--text-5xl);
		font-weight: var(--weight-black);
		color: var(--color-white);
		line-height: 1;
		display: block;
		-webkit-font-smoothing: auto;
	}
	.exclu-texte {
		font-family: var(--font-body);
		font-size: var(--text-2xl);
		font-weight: var(--weight-black);
		color: var(--color-white);
		line-height: 1.2;
		-webkit-font-smoothing: auto;
	}

	/* ── RESPONSIVE ── */
	@media (min-width: 640px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-l);
		}
	}
	@media (min-width: 768px) {
		.hero-logo-wrap {
			justify-content: center;
		}
		.hero-logo-img {
			height: clamp(5rem, 12vw, 9rem);
		}
		.hero-img {
			max-width: 100%;
		}
		.hero-card-overlay {
			max-width: 580px;
			bottom: var(--space-l);
		}
		.card-section {
			padding: var(--space-2xl);
			width: 100%;
		}
		.card-section__title {
			font-size: clamp(1.875rem, 5vw, 3rem);
			margin-bottom: var(--space-m);
		}
		.card-section__text {
			font-size: var(--text-xl);
		}
		.aide-titre {
			font-size: clamp(3rem, 10vw, 4.5rem);
		}
		.aide-img {
			max-width: 900px;
		}
		.services-grid {
			width: 90%;
			gap: var(--space-xl);
		}
		.exclu-wrap {
			flex-direction: row;
			align-items: flex-start;
			gap: var(--space-xl);
			max-width: 850px;
		}
		.exclu-media-card {
			flex-shrink: 0;
			width: 490px;
			max-width: 490px;
			padding: 1.75rem;
			border-radius: 1.75rem;
			border-width: 3.5px;
		}
		.exclu-media-titre {
			font-size: calc(var(--text-xl) * 1.75);
		}
		.exclu-body {
			padding-top: var(--space-m);
			max-width: 360px;
			justify-content: space-between;
		}
		.exclu-texte {
			font-size: var(--text-3xl);
		}
	}
	@media (min-width: 1024px) {
		.services-grid {
			grid-template-columns: repeat(2, 1fr);
			width: 85%;
			gap: var(--space-xl);
		}
	}
</style>
