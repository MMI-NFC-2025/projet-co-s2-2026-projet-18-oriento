---
import Layout from "../layouts/Layout.astro";
import CardAvance from "../components/CardAvance.astro";
import CardSection from "../components/CardSection.astro";
import DocumentsSection from "../components/DocumentsSection.astro";
import QuestionsSection from "../components/QuestionsSection.astro";
import Img1 from "../assets/Oriento_img/Loger_img.avif";
import logoCompletBlanc from "../assets/Oriento_img/logo_complet_blanc.avif";

const parcours = [
    "Trouver un logement",
    "Préparer son dossier",
    "Signer le bail",
];

const CATEGORIE = "logement";
---

<Layout title="Se loger — Oriento" heroSection={true}>
    <div class="page-wrapper">
        <section class="hero-section" aria-label="Présentation">
            <div class="hero-inner">
                <div class="hero-logo-wrap">
                    <img
                        src={logoCompletBlanc.src}
                        alt="Oriento"
                        width="800"
                        height="250"
                        class="hero-logo-img"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
                <div class="hero-texte"><p>Logement</p></div>
                <div class="hero-img-wrap">
                    <img
                        src={Img1.src}
                        alt="Étudiant cherchant un logement"
                        width="900"
                        height="600"
                        class="hero-img"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
            </div>
        </section>

        <section class="intro-section" aria-label="Introduction">
            <div class="intro-inner">
                <h1 class="intro-h1">Se loger</h1>
                <h2 class="intro-h2">
                    Toutes les démarches pour trouver et gérer ton logement !
                </h2>
                <p class="intro-texte">
                    Trouver un logement peut être compliqué, surtout quand on ne
                    connaît pas les démarches à suivre. Cette page t'accompagne
                    étape par étape.
                </p>
            </div>
        </section>

        <section class="parcours-section" aria-label="Parcours logement">
            <div
                class="parcours-card"
                role="region"
                aria-label="Suivi de progression"
            >
                <div class="parcours-barres" aria-hidden="true">
                    {
                        parcours.map((_, i) => (
                            <div class="parcours-barre" data-barre={i} />
                        ))
                    }
                </div>
                <p class="parcours-titre" id="parcours-label">
                    Ton parcours logement
                </p>
                <p class="parcours-sync" id="parcours-sync" aria-live="polite">
                </p>
                <ul
                    class="parcours-liste"
                    role="list"
                    aria-labelledby="parcours-label"
                >
                    {
                        parcours.map((etape, i) => (
                            <li class="parcours-etape" data-index={i}>
                                <button
                                    class="parcours-check"
                                    type="button"
                                    aria-pressed="false"
                                    aria-label={`Marquer "${etape}" comme complété`}
                                    data-step={i}
                                    data-etape={`etape_${i + 1}`}
                                >
                                    <svg
                                        viewBox="0 0 12 12"
                                        fill="none"
                                        aria-hidden="true"
                                    >
                                        <polyline
                                            points="2,6 5,9 10,3"
                                            stroke="white"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                    </svg>
                                </button>
                                <span class="parcours-label">{etape}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </section>

        <section class="avance-section" aria-label="Thématiques logement">
            <div class="avance-grid">
                <CardAvance
                    titre="Recherche de logement"
                    texte="Astuces pour trouver un appartement ou une colocation proche de votre campus."
                    href="/logement/recherche"
                />
                <CardAvance
                    titre="Entretien et services"
                    texte="Conseils pour entretenir votre logement et accéder à Internet, eau, électricité."
                    href="/logement/entretien"
                />
                <CardAvance
                    titre="Éviter les arnaques"
                    texte="Découvrez comment repérer et éviter les arnaques étudiantes en toute sécurité."
                    href="/logement/arnaques"
                />
            </div>
        </section>

        <section class="dynamique-section" aria-label="Ressources logement">
            <h2 class="dynamique-titre">Ressources</h2>
            <div class="dynamique-grid">
                <CardSection
                    titre="Préparer son dossier"
                    texte="Découvre la liste des documents nécessaires pour tes démarches !"
                    href="/logement/preparer"
                    btnLabel="Voir la checklist"
                    side="right"
                />
                <CardSection
                    titre="Signer son bail"
                    texte="Comprendre :"
                    bullets={[
                        "le bail",
                        "le dépôt de garantie",
                        "l'état des lieux",
                        "les obligations du locataire",
                    ]}
                    href="/logement/bail"
                    btnLabel="Comprendre le bail"
                    side="left"
                />
                <CardSection
                    titre="Demander les aides"
                    texte="Aides disponibles :"
                    bullets={["APL", "ALS"]}
                    href="/logement/aides"
                    btnLabel="Faire la demande"
                    side="right"
                />
            </div>
        </section>

        <DocumentsSection />

        <!-- ── CARTE LOGEMENT ── -->
        <section
            class="carte-section"
            aria-label="Logements et services proches"
        >
            <div class="carte-header">
                <h2 class="carte-titre">Trouver un logement</h2>
                <p class="carte-sous-titre">
                    Recherche des résidences et agences près de chez toi
                </p>
                <div class="carte-recherche">
                    <input
                        type="text"
                        id="carte-ville"
                        class="carte-input"
                        placeholder="Ex : Paris, Lyon, Bordeaux..."
                        value="Paris"
                        aria-label="Ville ou commune à rechercher"
                    />
                    <button id="carte-rechercher" class="carte-btn">
                        Rechercher
                    </button>
                </div>
                <div
                    class="carte-filtres"
                    role="group"
                    aria-label="Filtrer par type"
                >
                    <button class="filtre-btn actif" data-type="tous"
                        >Tous</button
                    >
                    <button class="filtre-btn" data-type="Résidence CROUS"
                        >Résidence CROUS</button
                    >
                    <button class="filtre-btn" data-type="Agence immobilière"
                        >Agence immobilière</button
                    >
                    <button class="filtre-btn" data-type="Mairie">Mairie</button
                    >
                </div>
            </div>
            <div
                id="carte-map"
                class="carte-map"
                aria-label="Carte des logements et services"
            >
            </div>
            <p id="carte-status" class="carte-status" aria-live="polite"></p>
        </section>

        <QuestionsSection href="/a-propos" />
    </div>
</Layout>

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>

<style>
    .page-wrapper {
        background: var(--color-blue-light);
    }

    /* HERO */
    .hero-section {
        background: var(--color-yellow);
        min-height: calc(100svh - 5rem);
        display: flex;
        align-items: stretch;
    }
    .hero-inner {
        width: 100%;
        max-width: 1152px;
        margin: 0 auto;
        padding: var(--space-l) var(--space-sm);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        flex: 1;
        gap: var(--space-sm);
    }
    .hero-logo-wrap {
        width: 100%;
        display: flex;
        justify-content: flex-start;
    }
    .hero-logo-img {
        height: clamp(6rem, 28vw, 9rem);
        width: auto;
    }
    .hero-img-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-end;
    }
    .hero-img {
        width: 100%;
        max-width: 480px;
        height: auto;
        object-fit: contain;
        object-position: bottom;
    }
    .hero-texte {
        width: 100%;
        padding: var(--space-m) 0;
    }
    .hero-texte p {
        font-family: var(--font-body);
        font-size: var(--text-5xl);
        font-weight: var(--weight-bold);
        color: var(--color-dark);
        line-height: 1.1;
    }

    /* INTRO */
    .intro-section {
        padding: var(--space-2xl) var(--space-sm) var(--space-l);
    }
    .intro-inner {
        max-width: 720px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        align-items: center;
    }
    .intro-h1 {
        font-family: var(--font-body);
        font-size: var(--text-4xl);
        font-weight: var(--weight-black);
        color: var(--color-white);
        text-align: center;
        line-height: 1.05;
        -webkit-font-smoothing: auto;
    }
    .intro-h2 {
        font-family: var(--font-body);
        font-size: clamp(var(--text-xl), 4vw, var(--text-3xl));
        font-weight: var(--weight-black);
        color: var(--color-white);
        line-height: 1.15;
        -webkit-font-smoothing: auto;
    }
    .intro-texte {
        font-family: var(--font-body);
        font-size: clamp(var(--text-sm), 2.5vw, var(--text-m));
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.7;
        max-width: 62ch;
    }

    /* PARCOURS */
    .parcours-section {
        padding: 0 var(--space-sm) var(--space-2xl);
    }
    .parcours-card {
        max-width: 520px;
        margin: 0 auto;
        background: var(--color-white);
        border-radius: var(--radius-m);
        overflow: hidden;
        box-shadow: var(--shadow-m);
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        padding-bottom: var(--space-l);
    }
    .parcours-barres {
        display: flex;
        gap: 6px;
        padding: var(--space-m) var(--space-l) 0;
    }
    .parcours-barre {
        flex: 1;
        height: 5px;
        border-radius: 9999px;
        background: #e0e0e0;
        transition: background 0.3s;
    }
    .parcours-barre.done {
        background: var(--color-blue-light);
    }
    .parcours-titre {
        font-family: var(--font-body);
        font-size: var(--text-m);
        font-weight: var(--weight-bold);
        color: var(--color-dark);
        padding: 0 var(--space-l);
    }
    .parcours-sync {
        font-size: var(--text-xs);
        color: var(--color-dark);
        opacity: 0.45;
        padding: 0 var(--space-l);
        margin-top: calc(var(--space-m) * -1);
        min-height: 1em;
    }
    .parcours-liste {
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
        list-style: none;
        padding: 0 var(--space-l);
        margin: 0;
    }
    .parcours-etape {
        display: flex;
        align-items: center;
        gap: var(--space-m);
    }
    .parcours-check {
        flex-shrink: 0;
        width: 14px;
        height: 14px;
        border: 2px solid #d0d0d0;
        border-radius: 3px;
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        margin: -15px;
        box-sizing: content-box;
        transition:
            background 0.2s,
            border-color 0.2s;
    }
    .parcours-check svg {
        width: 8px;
        height: 8px;
        opacity: 0;
        transition: opacity 0.15s;
        pointer-events: none;
    }
    .parcours-check[aria-pressed="true"] {
        background: var(--color-blue-light);
        border-color: var(--color-blue-light);
    }
    .parcours-check[aria-pressed="true"] svg {
        opacity: 1;
    }
    .parcours-label {
        font-family: var(--font-body);
        font-size: var(--text-m);
        color: var(--color-dark);
        transition: opacity 0.2s;
    }
    .parcours-etape.done .parcours-label {
        opacity: 0.4;
        text-decoration: line-through;
    }

    /* CARDS */
    .avance-section {
        padding: var(--space-xl) var(--space-sm);
    }
    .avance-grid {
        max-width: 960px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-m);
    }
    .dynamique-titre {
        font-family: var(--font-body);
        font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
        font-weight: var(--weight-black);
        color: var(--color-white);
        text-align: center;
        -webkit-font-smoothing: auto;
    }
    .dynamique-section {
        padding: var(--space-xl) 0 var(--space-2xl);
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
        align-items: center;
    }
    .dynamique-grid {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
    }

    /* CARTE */
    .carte-section {
        padding: var(--space-2xl) var(--space-sm);
        display: flex;
        flex-direction: column;
        gap: var(--space-l);
        align-items: center;
    }
    .carte-header {
        width: 100%;
        max-width: 900px;
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
    }
    .carte-titre {
        font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
        font-weight: var(--weight-black);
        color: var(--color-white);
    }
    .carte-sous-titre {
        font-size: var(--text-sm);
        color: rgba(255, 255, 255, 0.75);
    }
    .carte-recherche {
        display: flex;
        gap: var(--space-s);
        flex-wrap: wrap;
    }
    .carte-input {
        flex: 1;
        min-width: 200px;
        background: var(--color-white);
        border: none;
        border-radius: var(--radius-m);
        padding: var(--space-m);
        font-size: var(--text-sm);
        color: var(--color-dark);
        outline: none;
        transition: box-shadow 0.2s;
    }
    .carte-input:focus {
        box-shadow: 0 0 0 2px var(--color-yellow);
    }
    .carte-btn {
        background: var(--color-yellow);
        color: var(--color-dark);
        border: none;
        border-radius: var(--radius-m);
        padding: var(--space-m) var(--space-l);
        font-size: var(--text-sm);
        font-weight: var(--weight-bold);
        cursor: pointer;
        transition:
            opacity 0.2s,
            transform 0.15s;
        white-space: nowrap;
    }
    .carte-btn:hover {
        opacity: 0.88;
        transform: translateY(-1px);
    }
    .carte-filtres {
        display: flex;
        gap: var(--space-s);
        flex-wrap: wrap;
    }
    .filtre-btn {
        padding: var(--space-s) var(--space-m);
        border-radius: 9999px;
        border: 2px solid var(--color-white);
        background: transparent;
        color: var(--color-white);
        font-size: var(--text-sm);
        font-weight: var(--weight-medium);
        cursor: pointer;
        transition: all 0.2s;
    }
    .filtre-btn.actif,
    .filtre-btn:hover {
        background: var(--color-white);
        color: var(--color-dark);
    }
    .carte-map {
        width: 100%;
        max-width: 900px;
        height: 460px;
        border-radius: var(--radius-l);
        overflow: hidden;
        box-shadow: var(--shadow-m);
        z-index: 0;
    }
    .carte-status {
        font-size: var(--text-sm);
        color: rgba(255, 255, 255, 0.7);
        min-height: 1.2em;
    }

    /* RESPONSIVE */
    @media (min-width: 640px) {
        .avance-grid,
        .dynamique-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (min-width: 768px) {
        .intro-texte {
            font-size: var(--text-xl);
            font-weight: 600;
        }
        .hero-logo-wrap {
            justify-content: center;
        }
        .hero-logo-img {
            height: clamp(5rem, 12vw, 9rem);
        }
        .hero-img {
            max-width: 100%;
        }
        .hero-texte p {
            font-size: 7rem;
        }
        .avance-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

<script>
    import PocketBase from "pocketbase";

    // ══ PROGRESSION ═══════════════════════════════════════════
    const CATEGORIE = "logement";
    const pb = new PocketBase("http://127.0.0.1:8090");
    const barres = Array.from(
        document.querySelectorAll<HTMLElement>(".parcours-barre"),
    );
    const boutons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".parcours-check"),
    );
    const etapes = Array.from(
        document.querySelectorAll<HTMLElement>(".parcours-etape"),
    );
    const syncEl = document.getElementById("parcours-sync");
    const total = barres.length;
    const etat: boolean[] = new Array(total).fill(false);

    function setSync(msg: string) {
        if (syncEl) syncEl.textContent = msg;
    }

    function render() {
        let prog = 0;
        while (prog < total && etat[prog]) prog++;
        barres.forEach((b, i) => b.classList.toggle("done", i < prog));
        boutons.forEach((btn, i) => {
            btn.setAttribute("aria-pressed", String(etat[i]));
            btn.setAttribute(
                "aria-label",
                (etat[i] ? "Décocher" : "Marquer") +
                    ` "${etapes[i].querySelector(".parcours-label")?.textContent}" comme complété`,
            );
        });
        etapes.forEach((li, i) => li.classList.toggle("done", etat[i]));
    }

    async function chargerProgression() {
        if (!pb.authStore.isValid) return;
        try {
            const userId = pb.authStore.model?.id;
            const records = await pb.collection("progression").getFullList({
                filter: `user = "${userId}" && categorie = "${CATEGORIE}"`,
            });
            records.forEach((r) => {
                const match = r.etape.match(/etape_(\d+)/);
                if (match) {
                    const idx = parseInt(match[1]) - 1;
                    if (idx >= 0 && idx < total) etat[idx] = r.completee;
                }
            });
            render();
            setSync("✓ Progression chargée");
            setTimeout(() => setSync(""), 2000);
        } catch (e) {
            setSync("Impossible de charger la progression");
        }
    }

    async function sauvegarderEtape(index: number, completee: boolean) {
        if (!pb.authStore.isValid) return;
        const userId = pb.authStore.model?.id;
        const etapeKey = `etape_${index + 1}`;
        try {
            setSync("Sauvegarde...");
            const existing = await pb
                .collection("progression")
                .getFirstListItem(
                    `user = "${userId}" && categorie = "${CATEGORIE}" && etape = "${etapeKey}"`,
                )
                .catch(() => null);
            if (existing) {
                await pb
                    .collection("progression")
                    .update(existing.id, { completee });
            } else {
                await pb.collection("progression").create({
                    user: userId,
                    categorie: CATEGORIE,
                    etape: etapeKey,
                    completee,
                });
            }
            setSync("✓ Sauvegardé");
            setTimeout(() => setSync(""), 2000);
        } catch (e) {
            setSync("Erreur de sauvegarde");
        }
    }

    boutons.forEach((btn, i) => {
        btn.addEventListener("click", () => {
            if (!etat[i]) {
                for (let j = 0; j <= i; j++) etat[j] = true;
                for (let j = 0; j <= i; j++) sauvegarderEtape(j, true);
            } else {
                for (let j = i; j < total; j++) etat[j] = false;
                for (let j = i; j < total; j++) sauvegarderEtape(j, false);
            }
            render();
            if (!pb.authStore.isValid)
                setSync("Connecte-toi pour sauvegarder ta progression");
        });
    });

    render();
    chargerProgression();

    // ══ CARTE OPENSTREETMAP ════════════════════════════════════
    document.addEventListener("DOMContentLoaded", () => {
        const L = (window as any).L;

        const statusEl = document.getElementById("carte-status");
        const villeInput = document.getElementById(
            "carte-ville",
        ) as HTMLInputElement;
        const recherchBtn = document.getElementById("carte-rechercher");

        // Couleurs par type de service logement
        const couleurs: Record<string, string> = {
            "Résidence CROUS": "#3b82f6",
            "Agence immobilière": "#f59e0b",
            Mairie: "#10b981",
        };

        const carte = L.map("carte-map").setView([46.6034, 1.8883], 6);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution:
                '© <a href="https://www.openstreetmap.org/copyright" target="_blank">OpenStreetMap</a>',
            maxZoom: 19,
        }).addTo(carte);

        let tousLesLieux: {
            nom: string;
            adresse: string;
            lat: number;
            lng: number;
            type: string;
            marqueur: any;
        }[] = [];
        let filtreActif = "tous";

        function creerIcone(type: string) {
            const couleur = couleurs[type] ?? "#6366f1";
            return L.divIcon({
                className: "",
                html: `<div style="background:${couleur};width:12px;height:12px;border-radius:50%;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.35)"></div>`,
                iconSize: [12, 12],
                iconAnchor: [6, 6],
            });
        }

        function afficherFiltres() {
            tousLesLieux.forEach(({ type, marqueur }) => {
                if (filtreActif === "tous" || filtreActif === type) {
                    marqueur.addTo(carte);
                } else {
                    marqueur.remove();
                }
            });
        }

        async function rechercherLogements(ville: string) {
            if (statusEl) statusEl.textContent = "Recherche en cours...";
            tousLesLieux.forEach(({ marqueur }) => marqueur.remove());
            tousLesLieux = [];

            // Requêtes adaptées au logement étudiant
            const types = [
                { label: "Résidence CROUS", query: "résidence CROUS" },
                { label: "Agence immobilière", query: "agence immobilière" },
                { label: "Mairie", query: "mairie" },
            ];

            let count = 0;

            for (const type of types) {
                try {
                    const url = `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(type.query + " " + ville)}&format=json&limit=6&countrycodes=fr`;
                    const res = await fetch(url, {
                        headers: { "Accept-Language": "fr" },
                    });
                    const data = await res.json();

                    data.forEach((lieu: any) => {
                        const lat = parseFloat(lieu.lat);
                        const lng = parseFloat(lieu.lon);
                        const nom = lieu.display_name.split(",")[0];
                        const adresse = lieu.display_name;

                        const marqueur = L.marker([lat, lng], {
                            icon: creerIcone(type.label),
                        }).bindPopup(`
                            <div style="font-family:sans-serif;min-width:180px">
                                <strong style="font-size:13px">${nom}</strong><br>
                                <span style="font-size:11px;color:#666;display:inline-block;margin:4px 0">${type.label}</span><br>
                                <span style="font-size:11px;color:#999">${adresse.split(",").slice(0, 3).join(", ")}</span>
                            </div>
                        `);

                        tousLesLieux.push({
                            nom,
                            adresse,
                            lat,
                            lng,
                            type: type.label,
                            marqueur,
                        });
                        count++;
                    });

                    await new Promise((r) => setTimeout(r, 1100));
                } catch (e) {
                    console.error(`Erreur pour ${type.label}:`, e);
                }
            }

            afficherFiltres();

            if (tousLesLieux.length > 0) {
                const bounds = L.latLngBounds(
                    tousLesLieux.map((l: any) => [l.lat, l.lng]),
                );
                carte.fitBounds(bounds, { padding: [40, 40] });
            }

            if (statusEl)
                statusEl.textContent =
                    count > 0
                        ? `${count} lieux trouvés à ${ville}`
                        : "Aucun résultat trouvé.";
        }

        recherchBtn?.addEventListener("click", () => {
            const ville = villeInput?.value.trim();
            if (ville) rechercherLogements(ville);
        });

        villeInput?.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                const ville = villeInput.value.trim();
                if (ville) rechercherLogements(ville);
            }
        });

        document
            .querySelectorAll<HTMLButtonElement>(".filtre-btn")
            .forEach((btn) => {
                btn.addEventListener("click", () => {
                    document
                        .querySelectorAll(".filtre-btn")
                        .forEach((b) => b.classList.remove("actif"));
                    btn.classList.add("actif");
                    filtreActif = btn.dataset.type ?? "tous";
                    afficherFiltres();
                });
            });

        rechercherLogements("Paris");
    });
</script>
