---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Menu   from "../components/Menu.astro";

const services = [
  {
    num: "01", title: "Se loger",
    desc: "Premier appart', coloc ou résidence étudiante : on te guide dans toutes tes démarches pour trouver et sécuriser ton logement.",
    href: "/loger",
    img:  "/src/assets/img/loger_img.avif",
    alt:  "Illustration d'une chambre étudiante meublée et confortable",
    color: "bg-[#EEF0FF]",
  },
  {
    num: "02", title: "Impôts",
    desc: "Déclaration de revenus, crédit d'impôt, exonérations étudiantes : on t'explique comment déclarer sans stress.",
    href: "/impots",
    img:  "/src/assets/img/impot_img.avif",
    alt:  "Illustration d'un formulaire fiscal simplifié pour étudiant",
    color: "bg-[#FFF8E0]",
  },
  {
    num: "03", title: "Etudes",
    desc: "Bourses, inscriptions, équivalences, alternance : on t'aide à naviguer dans le système éducatif français.",
    href: "/etudes",
    img:  "/src/assets/img/etude_img.avif",
    alt:  "Illustration d'un étudiant avec des livres et un diplôme",
    color: "bg-[#E8F9EE]",
  },
  {
    num: "04", title: "Assurances",
    desc: "Habitation obligatoire, responsabilité civile, mutuelle santé : ce qui est indispensable, expliqué simplement.",
    href: "/assurances",
    img:  "/src/assets/img/assu_img.avif",
    alt:  "Illustration d'un bouclier symbolisant la protection par l'assurance étudiante",
    color: "bg-[#FFF0F0]",
  },
];
---

<Layout
  title="Accueil"
  description="Oriento – Premier appart, impôts, études, assurances : ton guide complet pour une rentrée sereine."
>
  <Header />
  <Menu />

  <main id="main-content" tabindex="-1">

    <!-- ═══ HERO ══════════════════════════════════════════ -->
    <section class="relative bg-[#F5C500] min-h-[100svh] overflow-hidden" aria-labelledby="hero-title">

      <!-- Watermark logo en arrière-plan -->
      <div class="absolute inset-0 flex items-end justify-center pb-0 pointer-events-none overflow-hidden" aria-hidden="true">
        <img
          src="/src/assets/img/logo_complet_blanc.avif"
          alt=""
          class="w-[420px] max-w-[140%] opacity-[0.06] translate-y-8"
          width="420" height="140"
          loading="eager" decoding="async"
        />
      </div>

      <!-- Contenu du hero -->
      <div class="relative z-10 w-full max-w-[480px] mx-auto px-5 pt-24 pb-6">

        <!-- Tag -->
        <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.1em] uppercase text-[#0F0F0E]/55 mb-5">
          <span aria-hidden="true">✦</span> Ton guide étudiant
        </p>

        <!-- Image hero (à venir) — placeholder en attendant -->
        <div
          class="relative w-full rounded-2xl overflow-hidden mb-0"
          style="aspect-ratio:3/4;"
        >
          <img
            src="/src/assets/img/hero_landingpage.avif"
            alt="Étudiant serein accompagné par Oriento dans ses démarches administratives"
            class="w-full h-full object-cover object-top"
            width="480" height="640"
            loading="eager" decoding="async" fetchpriority="high"
          />
          <!-- Overlay gradient bas -->
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[#F5C500]/80 to-transparent" aria-hidden="true"></div>
        </div>

      </div>

      <!-- Quote card -->
      <div class="relative z-10 mx-5 max-w-[480px] md:mx-auto -mt-8 pb-10">
        <div class="bg-[#0F0F0E] text-white rounded-2xl p-6 shadow-[0_8px_32px_rgba(0,0,0,0.25)]">
          <span class="text-[#F5C500] text-5xl font-black leading-none block -mb-1" aria-hidden="true">"</span>
          <p
            class="text-xl font-bold leading-snug mt-2"
            style="font-family:var(--font-display);"
          >
            Avec Oriento les démarches deviennent plus simples
          </p>
        </div>
      </div>

    </section>

    <!-- ═══ SECTION 1 : Démarches Quesako ══════════════ -->
    <section
      class="bg-[#EEF0FF] px-5 py-10 md:py-16"
      aria-labelledby="demarches-title"
    >
      <div class="w-full max-w-[480px] mx-auto md:max-w-[1200px] md:px-8">
        <div class="md:grid md:grid-cols-2 md:gap-12 md:items-center">

          <div class="mb-8 md:mb-0" data-reveal>
            <p class="text-xs font-semibold tracking-[0.12em] uppercase text-[#6473D6] mb-3">
              Notre mission
            </p>
            <h2
              id="demarches-title"
              class="text-[clamp(1.75rem,4vw,3rem)] font-black leading-tight tracking-tight text-[#0F0F0E] mb-4"
              style="font-family:var(--font-display);"
            >
              Démarches administra...?<br/>Quesako ?
            </h2>
            <p class="text-base text-[#0F0F0E]/65 leading-relaxed max-w-[44ch]">
              Pas de panique ! Oriento est là pour vous aider à y voir plus clair.
              On traduit le jargon administratif en étapes simples et concrètes.
            </p>
          </div>

          <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-[#DDE1F8]" data-reveal>
            <img
              src="/src/assets/img/Home_img1.avif"
              alt="Illustration de démarches administratives simplifiées par Oriento"
              class="w-full h-full object-cover"
              width="600" height="450"
              loading="lazy" decoding="async"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ SECTION 2 : Ressources pédagogiques ════════ -->
    <section
      class="bg-[#6473D6] px-5 py-10 md:py-16"
      aria-labelledby="ressources-title"
    >
      <div class="w-full max-w-[480px] mx-auto md:max-w-[1200px] md:px-8">
        <div class="md:grid md:grid-cols-[1fr_auto] md:gap-12 md:items-center">

          <div data-reveal>
            <p class="text-xs font-semibold tracking-[0.12em] uppercase text-white/60 mb-3">
              Ressources
            </p>
            <h2
              id="ressources-title"
              class="text-[clamp(1.75rem,4vw,3rem)] font-black leading-tight tracking-tight text-white mb-4"
              style="font-family:var(--font-display);"
            >
              Des centaines de ressources pédagogiques !
            </h2>
            <p class="text-base text-white/70 leading-relaxed max-w-[44ch] mb-6">
              Pour enfin se réconcilier avec l'administration. Guides, checklists,
              vidéos explicatives — tout est gratuit.
            </p>
            <a
              href="/inscription"
              class="inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold bg-white text-[#6473D6] rounded-full no-underline hover:opacity-90 transition-opacity duration-200 min-h-[48px]"
              aria-label="Accéder aux ressources pédagogiques"
            >
              Découvrir les ressources
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <!-- Image déco desktop -->
          <div class="hidden md:block w-72 rounded-2xl overflow-hidden aspect-[3/4]" aria-hidden="true" data-reveal>
            <img
              src="/src/assets/img/Home_img2.avif"
              alt=""
              class="w-full h-full object-cover"
              width="288" height="384"
              loading="lazy" decoding="async"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ SERVICES GRID ═══════════════════════════════ -->
    <section class="bg-white py-12 md:py-20 px-5" aria-labelledby="services-title">
      <div class="w-full max-w-[1200px] mx-auto md:px-8">

        <header class="mb-10">
          <p class="text-xs font-semibold tracking-[0.12em] uppercase text-[#0F0F0E]/45 mb-3">
            Nos thématiques
          </p>
          <h2
            id="services-title"
            class="text-[clamp(1.75rem,4vw,3rem)] font-black leading-tight tracking-tight text-[#0F0F0E]"
            style="font-family:var(--font-display);"
          >
            Tout ce dont tu as besoin,<br class="hidden md:block"/> au même endroit
          </h2>
        </header>

        <ul role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {services.map((s, i) => (
            <li
              class="opacity-0 translate-y-6 transition-all duration-500"
              style={`transition-delay:${i * 80}ms`}
              data-reveal
            >
              <a
                href={s.href}
                class={`group flex flex-col h-full rounded-2xl overflow-hidden no-underline text-inherit hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(0,0,0,0.1)] transition-all duration-300 ${s.color}`}
                aria-label={`En savoir plus sur : ${s.title}`}
              >
                <!-- Image -->
                <div class="relative overflow-hidden aspect-[4/3]">
                  <img
                    src={s.img}
                    alt={s.alt}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    width="400" height="300"
                    loading="lazy" decoding="async"
                  />
                  <span
                    class="absolute top-3 right-4 text-xs font-semibold tracking-[0.08em] text-[#0F0F0E]/30"
                    aria-hidden="true"
                  >
                    {s.num}
                  </span>
                </div>

                <!-- Body -->
                <div class="flex flex-col flex-1 gap-3 p-5">
                  <h3
                    class="font-extrabold leading-tight tracking-tight text-[#0F0F0E]"
                    style="font-family:var(--font-display);font-size:clamp(1.1rem,2vw,1.4rem);"
                  >
                    {s.title}
                  </h3>
                  <p class="text-sm text-[#0F0F0E]/60 leading-relaxed flex-1" style="max-width:none;">
                    {s.desc}
                  </p>
                  <span
                    class="inline-flex items-center gap-2 text-xs font-semibold text-[#0F0F0E]/40 mt-auto group-hover:text-[#0F0F0E] group-hover:gap-3 transition-all duration-200"
                    aria-hidden="true"
                  >
                    Explorer
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" focusable="false">
                      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>

      </div>
    </section>

    <!-- ═══ CTA ══════════════════════════════════════════ -->
    <section class="bg-[#F5C500] py-12 md:py-20 px-5" aria-labelledby="cta-title">
      <div class="w-full max-w-[1200px] mx-auto md:px-8 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-8 items-center">

        <div data-reveal>
          <h2
            id="cta-title"
            class="text-[clamp(1.75rem,4vw,3rem)] font-black leading-tight tracking-tight text-[#0F0F0E] mb-3"
            style="font-family:var(--font-display);"
          >
            Prêt·e pour une<br/>rentrée sereine ?
          </h2>
          <p class="text-base text-[#0F0F0E]/65 max-w-[44ch]">
            Crée ton compte en 2 minutes et accède à tous nos guides gratuitement.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3" data-reveal>
          <a
            href="/inscription"
            class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold bg-[#0F0F0E] text-white rounded-full no-underline hover:opacity-80 transition-opacity duration-200 min-h-[52px] whitespace-nowrap"
            aria-label="Créer un compte Oriento gratuit"
          >
            Créer un compte
          </a>
          <a
            href="/connexion"
            class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-[#0F0F0E] border border-[#0F0F0E]/25 rounded-full no-underline hover:border-[#0F0F0E] transition-all duration-200 min-h-[48px] whitespace-nowrap"
            aria-label="Se connecter à mon compte Oriento"
          >
            Se connecter
          </a>
        </div>

      </div>
    </section>

  </main>

  <!-- ═══ FOOTER ════════════════════════════════════════ -->
  <footer class="bg-[#0F0F0E] border-t border-white/[0.06]" role="contentinfo">
    <div class="w-full max-w-[1200px] mx-auto px-5 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-8 pt-12 pb-10">

      <div>
        <a href="/accueil" aria-label="Oriento – Retour à l'accueil">
          <img
            src="/src/assets/img/logo_complet_blanc.avif"
            alt="Logo Oriento"
            class="h-8 w-auto mb-3"
            width="140" height="32"
            loading="lazy" decoding="async"
          />
        </a>
        <p class="text-sm text-white/45">Ton guide pour une rentrée sereine.</p>
      </div>

      <nav aria-label="Navigation du pied de page">
        <ul role="list" class="flex flex-col gap-2">
          {[
            { label: "Se loger",   href: "/loger"       },
            { label: "Impôts",     href: "/impots"      },
            { label: "Etudes",     href: "/etudes"      },
            { label: "Assurances", href: "/assurances"  },
            { label: "Contact",    href: "/contact"     },
          ].map(l => (
            <li>
              <a href={l.href}
                 class="text-sm text-white/45 no-underline hover:text-white transition-colors duration-200">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Réseaux sociaux d'Oriento">
        <ul role="list" class="flex flex-col gap-2">
          {[
            { label: "Instagram", href: "https://instagram.com" },
            { label: "Behance",   href: "https://behance.net"   },
            { label: "LinkedIn",  href: "https://linkedin.com"  },
          ].map(s => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer"
                 aria-label={`Oriento sur ${s.label} (ouvre dans un nouvel onglet)`}
                 class="text-sm text-white/45 no-underline hover:text-white transition-colors duration-200">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

    </div>
    <div class="border-t border-white/[0.06]">
      <div class="w-full max-w-[1200px] mx-auto px-5 md:px-8 py-4">
        <p class="text-xs text-white/20">&copy; 2026 Oriento. Tous droits réservés.</p>
      </div>
    </div>
  </footer>

</Layout>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.remove('opacity-0', 'translate-y-6');
        entry.target.classList.add('opacity-100', 'translate-y-0');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

  document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
</script>