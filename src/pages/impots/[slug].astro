---
import Layout from "../../layouts/Layout.astro";
import BoutonConseil from "../../components/BoutonConseil.astro";
import logoCompletBlanc from "../../assets/Oriento_img/logo_complet_blanc.avif";
import Img1 from "../../assets/Oriento_img/impot_impot_img.avif";

type PageData = {
    titre: string;
    intro: string;
    sections: {
        titre: string;
        texte?: string;
        bullets?: string[];
        conseils: string;
    }[];
};

export function getStaticPaths() {
    const pages: Record<string, PageData> = {
        comprendre: {
            titre: "Comprendre les impôts en tant qu'étudiant",
            intro: "Les impôts peuvent sembler compliqués quand on commence à être autonome. Pourtant, en comprendre les bases te permettra d'éviter les mauvaises surprises et de gérer ta situation fiscale sereinement.",
            sections: [
                {
                    titre: "C'est quoi l'impôt sur le revenu ?",
                    texte: "L'impôt sur le revenu est prélevé par l'État sur les sommes que tu gagnes :",
                    bullets: [
                        "Il est calculé selon un barème progressif : plus tu gagnes, plus tu paies",
                        "En dessous d'un certain seuil de revenus, tu n'es pas imposable",
                        "Il concerne tous les résidents fiscaux en France, y compris les étudiants qui travaillent",
                    ],
                    conseils:
                        "En tant qu'étudiant avec de petits revenus, tu seras souvent non imposable. Mais déclarer reste obligatoire dès que tu as des revenus, même faibles.",
                },
                {
                    titre: "Le foyer fiscal",
                    texte: "Le foyer fiscal désigne l'ensemble des personnes prises en compte pour le calcul de l'impôt :",
                    bullets: [
                        "Tant que tu es rattaché au foyer fiscal de tes parents, ce sont eux qui déclarent tes revenus",
                        "Si tu deviens fiscalement indépendant, tu dois faire ta propre déclaration",
                        "Le rattachement au foyer des parents peut être avantageux jusqu'à 25 ans",
                    ],
                    conseils:
                        "Compare les deux situations avec un simulateur sur impots.gouv.fr. Parfois, se détacher du foyer parental est plus avantageux pour bénéficier de certaines aides.",
                },
                {
                    titre: "Le prélèvement à la source",
                    texte: "Depuis 2019, l'impôt est prélevé directement sur ton salaire chaque mois :",
                    bullets: [
                        "Si tu as un job étudiant, l'impôt est déduit automatiquement de ta fiche de paie",
                        "Ton taux de prélèvement est calculé par l'administration fiscale",
                        "Tu peux demander un taux neutre si tu ne veux pas communiquer ta situation à ton employeur",
                    ],
                    conseils:
                        "Si ton taux de prélèvement te semble trop élevé, tu peux le modifier directement depuis ton espace personnel sur impots.gouv.fr.",
                },
                {
                    titre: "Les revenus non imposables",
                    texte: "Certaines sommes perçues ne sont pas soumises à l'impôt :",
                    bullets: [
                        "Les bourses sur critères sociaux (CROUS)",
                        "Les allocations familiales et certaines aides de la CAF",
                        "Les indemnités de stage inférieures au SMIC annuel",
                    ],
                    conseils:
                        "Même si tes revenus sont exonérés, il peut être utile de les déclarer pour établir ton historique fiscal et accéder à certaines aides sociales.",
                },
            ],
        },
        espace: {
            titre: "Créer et utiliser son espace fiscal",
            intro: "Ton espace personnel sur impots.gouv.fr est ton tableau de bord fiscal. C'est là que tu déclares tes revenus, consultes tes avis d'imposition et gères ta situation. Voici comment le prendre en main.",
            sections: [
                {
                    titre: "Créer son compte impots.gouv.fr",
                    texte: "La création du compte est simple et se fait en quelques minutes :",
                    bullets: [
                        "Rends-toi sur impots.gouv.fr et clique sur « Votre espace particulier »",
                        "Crée ton compte avec ton numéro fiscal (visible sur un avis d'imposition ou une déclaration de revenus)",
                        "Si tu n'as jamais déclaré, tu peux obtenir ton numéro fiscal auprès du centre des impôts de ta commune",
                    ],
                    conseils:
                        "Ton numéro fiscal est personnel et ne change jamais. Note-le dans un endroit sûr dès ta première connexion.",
                },
                {
                    titre: "Les fonctionnalités principales",
                    texte: "Depuis ton espace, tu peux :",
                    bullets: [
                        "Déclarer tes revenus chaque année (avril-juin)",
                        "Consulter tes avis d'imposition et les télécharger",
                        "Modifier ton taux de prélèvement à la source",
                        "Signaler un changement de situation (déménagement, premier emploi...)",
                    ],
                    conseils:
                        "L'avis d'imposition est un document officiel très souvent demandé pour les dossiers de location, les bourses ou les aides sociales. Télécharge-le et garde-le à portée de main.",
                },
                {
                    titre: "Déclarer en ligne facilement",
                    texte: "La déclaration en ligne est guidée et pré-remplie :",
                    bullets: [
                        "Les revenus déclarés par ton employeur sont déjà pré-remplis automatiquement",
                        "Tu n'as qu'à vérifier, corriger si besoin, et valider",
                        "Tu reçois une confirmation immédiate et un récapitulatif par e-mail",
                    ],
                    conseils:
                        "Ne saute pas l'étape de vérification des cases pré-remplies. Une erreur de l'administration peut passer inaperçue si tu valides sans lire.",
                },
                {
                    titre: "Les délais à respecter",
                    texte: "La déclaration de revenus suit un calendrier annuel strict :",
                    bullets: [
                        "La campagne de déclaration ouvre généralement en avril",
                        "La date limite varie selon ton département (entre mai et juin)",
                        "Un retard de déclaration peut entraîner une majoration de 10 %",
                    ],
                    conseils:
                        "Active les alertes e-mail sur impots.gouv.fr pour être notifié à l'ouverture de la campagne et ne jamais rater la date limite.",
                },
            ],
        },
        declarer: {
            titre: "Dois-je déclarer mes revenus ?",
            intro: "Même en étant étudiant, tu peux être concerné par la déclaration de revenus. Tout dépend de ta situation, de ton âge et des revenus que tu perçois.",
            sections: [
                {
                    titre: "Êtes-vous rattaché au foyer fiscal de vos parents ?",
                    texte: "Si tu as moins de 25 ans et que tu es étudiant, tu peux rester rattaché au foyer fiscal de tes parents. Dans ce cas, ce sont généralement eux qui déclarent tes revenus avec les leurs.",
                    conseils:
                        "Discute avec tes parents de la situation la plus avantageuse. Le rattachement leur permet de bénéficier d'une demi-part supplémentaire, ce qui peut réduire leur impôt.",
                },
                {
                    titre: "Si vous faites votre propre déclaration",
                    texte: "Tu dois déclarer tes revenus si tu es indépendant fiscalement ou si tu as choisi de ne plus être rattaché au foyer de tes parents. Les revenus concernés peuvent être :",
                    bullets: [
                        "Salaire d'un job étudiant",
                        "Rémunération de stage",
                        "Revenus perçus pendant l'année",
                    ],
                    conseils:
                        "Même si tu n'es pas imposable, faire ta déclaration te permet d'obtenir un avis de non-imposition, souvent indispensable pour les dossiers de bourse ou de logement.",
                },
                {
                    titre: "Les revenus étudiants sont parfois exonérés",
                    texte: "Certains revenus étudiants peuvent être partiellement exonérés d'impôt, dans certaines limites. Cela concerne souvent les jobs étudiants exercés pendant les études.",
                    bullets: [
                        "Même si tu n'êtes pas imposable, une déclaration peut rester utile pour certaines aides ou démarches administratives",
                    ],
                    conseils:
                        "Consulte le simulateur sur impots.gouv.fr pour savoir exactement si tu es imposable selon tes revenus. C'est gratuit, rapide et sans engagement.",
                },
                {
                    titre: "Conseil",
                    texte: "Si tu as un doute, il est recommandé de faire une simulation ou de consulter les informations officielles pour connaître ta situation.",
                    conseils:
                        "N'hésite pas à contacter directement le centre des impôts de ta ville. Les agents fiscaux sont habitués aux questions des étudiants et peuvent t'orienter gratuitement.",
                },
            ],
        },
    };

    return Object.entries(pages).map(([slug, data]) => ({
        params: { slug },
        props: { page: data },
    }));
}

const { page } = Astro.props as { page: PageData };
---

<Layout title={`${page.titre} — Oriento`} heroSection={true}>
    <div class="page-wrapper">
        <section class="hero-section" aria-label="Présentation">
            <div class="hero-inner">
                <div class="hero-logo-wrap">
                    <img
                        src={logoCompletBlanc.src}
                        alt="Oriento"
                        width="800"
                        height="250"
                        class="hero-logo-img"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
                <div class="hero-texte">
                    <p>Les impôts</p>
                    <div class="hero-img-wrap">
                        <img
                            src={Img1.src}
                            alt="Illustration les impôts"
                            width="900"
                            height="600"
                            class="hero-img"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section class="intro-section" aria-label="Introduction">
            <div class="intro-inner">
                <h1 class="intro-h1">{page.titre}</h1>
                <p class="intro-texte">{page.intro}</p>
            </div>
        </section>

        <section class="cards-section" aria-label="Contenu">
            <div class="cards-grid">
                {
                    page.sections.map((s) => (
                        <div class="card">
                            <h3 class="card-titre">{s.titre}</h3>
                            {s.texte && <p class="card-texte">{s.texte}</p>}
                            {s.bullets && s.bullets.length > 0 && (
                                <ul class="card-bullets">
                                    {s.bullets.map((b) => (
                                        <li>{b}</li>
                                    ))}
                                </ul>
                            )}
                            <BoutonConseil conseils={s.conseils} />
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    <style>
        .page-wrapper {
            background: var(--color-blue-light);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* HERO */
        .hero-section {
            background: var(--color-yellow);
            display: flex;
            align-items: stretch;
        }
        .hero-inner {
            width: 100%;
            max-width: 1152px;
            margin: 0 auto;
            padding: var(--space-l) var(--space-sm);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            gap: var(--space-sm);
        }
        .hero-logo-wrap {
            width: 100%;
            display: flex;
            justify-content: flex-start;
        }
        .hero-logo-img {
            height: clamp(6rem, 28vw, 9rem);
            width: auto;
        }
        .hero-img-wrap {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: flex-end;
        }
        .hero-img {
            width: 100%;
            max-width: 480px;
            height: auto;
            object-fit: contain;
            object-position: bottom;
        }
        .hero-texte {
            width: 100%;
            padding: var(--space-m) 0;
        }
        .hero-texte p {
            font-family: var(--font-body);
            font-size: var(--text-5xl);
            font-weight: var(--weight-bold);
            color: var(--color-dark);
            line-height: 1.1;
        }

        /* INTRO */
        .intro-section {
            padding: var(--space-2xl) var(--space-sm) var(--space-l);
        }
        .intro-inner {
            max-width: 960px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
        }
        .intro-h1 {
            font-family: var(--font-body);
            font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl));
            font-weight: var(--weight-black);
            color: var(--color-white);
            line-height: 1.1;
            -webkit-font-smoothing: auto;
        }
        .intro-texte {
            font-family: var(--font-body);
            font-size: clamp(var(--text-sm), 2.5vw, var(--text-m));
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.7;
        }

        /* CARDS GRID */
        .cards-section {
            padding: var(--space-l) var(--space-sm) var(--space-3xl);
        }
        .cards-grid {
            max-width: 960px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr;
            gap: var(--space-m);
            width: 100%;
        }
        .card {
            background: var(--color-dark-blue);
            border-radius: var(--radius-m);
            padding: var(--space-l);
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
            min-width: 0;
            overflow: hidden;
        }
        .card-titre {
            font-family: var(--font-body);
            font-size: var(--text-m);
            font-weight: var(--weight-bold);
            color: var(--color-white);
            -webkit-font-smoothing: auto;
        }
        .card-texte {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-bold);
            color: var(--color-white);
            line-height: 1.6;
        }
        .card-bullets {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            padding-left: var(--space-m);
            margin: 0;
        }
        .card-bullets li {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-regular, 400);
            color: var(--color-white);
            line-height: 1.5;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        @media (min-width: 640px) {
            .cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (min-width: 768px) {
            .hero-logo-wrap {
                justify-content: center;
            }
            .hero-logo-img {
                height: clamp(5rem, 12vw, 9rem);
            }
            .hero-img {
                max-width: 100%;
            }
            .hero-texte p {
                font-size: 7rem;
            }
        }
    </style>
</Layout>
