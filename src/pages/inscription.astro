---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Inscription — Oriento" heroSection={false}>
    <div class="auth-page">
        <div class="auth-hero">
            <h1 class="auth-titre">Inscription</h1>
            <div class="auth-vague">
                <svg
                    viewBox="0 0 400 60"
                    xmlns="http://www.w3.org/2000/svg"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                >
                    <path
                        d="M0,30 Q100,0 200,30 Q300,60 400,30 L400,60 L0,60 Z"
                        fill="var(--color-blue-light)"></path>
                </svg>
            </div>
        </div>

        <div class="auth-body">
            <div class="auth-card">
                <form class="auth-form" novalidate>
                    <div class="form-group">
                        <label class="form-label" for="nom">Nom complet</label>
                        <input
                            class="form-input"
                            type="text"
                            id="nom"
                            name="nom"
                            placeholder="Votre nom"
                            autocomplete="name"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="email">Email</label>
                        <input
                            class="form-input"
                            type="email"
                            id="email"
                            name="email"
                            placeholder="Votre mail"
                            autocomplete="email"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="naissance"
                            >Date de naissance</label
                        >
                        <input
                            class="form-input"
                            type="date"
                            id="naissance"
                            name="naissance"
                            placeholder="Votre date de naissance"
                            autocomplete="bday"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="telephone"
                            >Téléphone</label
                        >
                        <input
                            class="form-input"
                            type="tel"
                            id="telephone"
                            name="telephone"
                            placeholder="Votre numéro de téléphone"
                            autocomplete="tel"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="password"
                            >Mot de passe</label
                        >
                        <input
                            class="form-input"
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Votre mot de passe"
                            autocomplete="new-password"
                            required
                        />
                    </div>
                    <button class="auth-btn" type="submit">S'inscrire</button>
                </form>
            </div>
            <p class="auth-switch">
                Déjà un compte ? <a href="/connexion">Se connecter</a>
            </p>
        </div>
    </div>

    <style>
        .auth-page {
            background: var(--color-blue-light);
            min-height: calc(100svh - 5rem);
            display: flex;
            flex-direction: column;
        }

        /* HERO */
        .auth-hero {
            background: var(--color-yellow);
            position: relative;
            padding: var(--space-2xl) var(--space-l) 0;
        }
        .auth-titre {
            font-family: var(--font-body);
            font-size: clamp(var(--text-4xl), 12vw, var(--text-6xl));
            font-weight: var(--weight-black);
            color: var(--color-dark);
            line-height: 1.05;
            -webkit-font-smoothing: auto;
            padding-bottom: var(--space-xl);
        }
        .auth-vague {
            width: 100%;
            line-height: 0;
            margin-bottom: -1px;
        }
        .auth-vague svg {
            width: 100%;
            height: 60px;
        }

        /* BODY */
        .auth-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: var(--space-xl) var(--space-sm) var(--space-2xl);
            gap: var(--space-l);
        }

        /* CARD */
        .auth-card {
            width: 100%;
            max-width: 360px;
            background: var(--color-white);
            border-radius: var(--radius-l);
            padding: var(--space-xl) var(--space-l);
            box-shadow: var(--shadow-m);
        }
        .auth-form {
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
        }
        .form-label {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-medium);
            color: var(--color-dark);
        }
        .form-input {
            width: 100%;
            background: var(--color-surface, #f0f2ff);
            border: none;
            border-radius: var(--radius-m);
            padding: var(--space-m);
            font-family: var(--font-body);
            font-size: var(--text-sm);
            color: var(--color-dark);
            outline: none;
            transition: box-shadow 0.2s;
        }
        .form-input::placeholder {
            color: #b0b0b0;
        }
        .form-input:focus {
            box-shadow: 0 0 0 2px var(--color-yellow);
        }
        .auth-btn {
            width: 100%;
            margin-top: var(--space-s);
            background: var(--color-yellow);
            color: var(--color-dark);
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-bold);
            border: none;
            border-radius: var(--radius-m);
            padding: var(--space-m);
            cursor: pointer;
            transition:
                opacity 0.2s,
                transform 0.15s;
        }
        .auth-btn:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }
        .auth-btn:active {
            transform: translateY(0);
        }

        /* SWITCH */
        .auth-switch {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            color: var(--color-white);
            text-align: center;
        }
        .auth-switch a {
            color: var(--color-yellow);
            font-weight: var(--weight-bold);
            text-decoration: none;
        }
        .auth-switch a:hover {
            text-decoration: underline;
        }
    </style>
</Layout>
