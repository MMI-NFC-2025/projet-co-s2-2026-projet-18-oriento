---
import "../styles/global.css"; // ← FIX critique

interface Props {
	title: string;
	description?: string;
}
const { title, description = "Oriento – Ton guide pour une rentrée sereine." } =
	Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title} | Oriento</title>
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link
			href="https://api.fontshare.com/v2/css?f[]=general-sans@300,400,500,600,700&f[]=cabinet-grotesk@700,800,900&display=swap"
			rel="stylesheet"
		/>
		<slot name="head" />
	</head>
	<body
		class="bg-white text-[#0F0F0E] min-h-dvh antialiased overflow-x-hidden"
		style="font-family:'General Sans',system-ui,sans-serif;"
	>
		<a
			href="#main-content"
			class="absolute top-2 left-2 z-[9999] px-4 py-2 bg-[#0F0F0E] text-white text-sm font-semibold rounded-md -translate-y-[150%] focus:translate-y-0 transition-transform duration-200 focus:outline-none"
		>
			Aller au contenu principal
		</a>

		<slot />
	</body>
</html>

<style is:global>
	:root {
		--font-display: "Cabinet Grotesk", "General Sans", sans-serif;
		--font-body: "General Sans", system-ui, sans-serif;
		--yellow: #f5c500;
		--dark: #0f0f0e;
		--blue-light: #eef0ff;
		--blue-mid: #6473d6;
	}

	body.menu-open {
		overflow: hidden;
	}

	/* Header scroll behaviour */
	.site-header {
		transition:
			background 300ms ease,
			border-color 300ms ease;
	}
	.site-header.scrolled {
		background: rgba(15, 15, 14, 0.92) !important;
		border-bottom-color: rgba(255, 255, 255, 0.08) !important;
	}
	.site-header.scrolled .header-logo-dark {
		display: none;
	}
	.site-header.scrolled .header-logo-light {
		display: block;
	}
	.site-header.scrolled .ham-bar {
		background: #f0efe9;
	}
	.site-header.scrolled .desktop-nav-link {
		color: #908f89;
	}
	.site-header.scrolled .btn-ghost {
		color: #908f89;
		border-color: rgba(255, 255, 255, 0.15);
	}
	.site-header.scrolled .btn-primary {
		background: #f0efe9;
		color: #0b0b0a;
	}

	/* Hamburger → X */
	.hamburger[aria-expanded="true"] .ham-bar:nth-child(1) {
		width: 22px;
		transform: translateY(6.5px) rotate(45deg);
	}
	.hamburger[aria-expanded="true"] .ham-bar:nth-child(2) {
		opacity: 0;
		width: 0;
	}
	.hamburger[aria-expanded="true"] .ham-bar:nth-child(3) {
		width: 22px;
		transform: translateY(-6.5px) rotate(-45deg);
	}

	/* Menu slide */
	#mobile-menu {
		pointer-events: none;
	}
	#mobile-menu.is-open {
		pointer-events: all;
	}
	.menu-backdrop {
		opacity: 0;
		transition: opacity 450ms cubic-bezier(0.76, 0, 0.24, 1);
	}
	#mobile-menu.is-open .menu-backdrop {
		opacity: 1;
	}
	.menu-panel {
		transform: translateX(100%);
		transition: transform 450ms cubic-bezier(0.76, 0, 0.24, 1);
	}
	#mobile-menu.is-open .menu-panel {
		transform: translateX(0);
	}
	.menu-item {
		transform: translateX(40px);
		opacity: 0;
		transition:
			transform 400ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 100ms),
			opacity 300ms ease var(--delay, 100ms);
	}
	#mobile-menu.is-open .menu-item {
		transform: translateX(0);
		opacity: 1;
	}

	/* Scroll reveal */
	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Focus & selection */
	:focus-visible {
		outline: 2px solid var(--dark);
		outline-offset: 3px;
		border-radius: 4px;
	}
	::selection {
		background: rgba(245, 197, 0, 0.35);
		color: var(--dark);
	}
</style>
