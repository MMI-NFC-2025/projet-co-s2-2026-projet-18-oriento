---
interface Props {
    titre: string;
    texte: string;
    href: string;
}
const { titre, texte, href } = Astro.props;
---

<article class="card-avance">
    <div class="card-avance-body">
        <h3 class="card-avance-titre">{titre}</h3>
        <p class="card-avance-texte">{texte}</p>
    </div>
    <a
        href={href}
        class="card-avance-btn"
        aria-label={`En savoir plus sur ${titre}`}
    >
        En savoir +
    </a>
</article>

<style>
    .card-avance {
        background: var(--color-white);
        border-radius: var(--radius-m);
        padding: var(--space-l);
        display: flex;
        flex-direction: column;
        gap: var(--space-m);
        box-shadow: var(--shadow-s);
    }
    .card-avance-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-xs);
    }
    .card-avance-titre {
        font-family: var(--font-body);
        font-size: var(--text-lg);
        font-weight: var(--weight-bold);
        color: var(--color-dark);
        line-height: 1.2;
    }
    .card-avance-texte {
        font-family: var(--font-body);
        font-size: var(--text-sm);
        color: var(--color-dark);
        line-height: 1.6;
        opacity: 0.75;
    }
    .card-avance-btn {
        display: inline-block;
        align-self: flex-start;
        background: var(--color-dark);
        color: var(--color-white);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        font-weight: var(--weight-bold);
        text-decoration: none;
        padding: var(--space-xs) var(--space-m);
        border-radius: var(--radius-full);
        transition:
            background 0.2s,
            transform 0.2s;
    }
    .card-avance-btn:hover {
        background: #3d60fe;
        transform: translateY(-2px);
    }
    .card-avance-btn:active {
        transform: translateY(0);
    }
</style>
