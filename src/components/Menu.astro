---
const navLinks = [
    { label: "Accueil", href: "/accueil", num: "01" },
    { label: "Se loger", href: "/loger", num: "02" },
    { label: "Impôts", href: "/impots", num: "03" },
    { label: "Etudes", href: "/etudes", num: "04" },
    { label: "Assurances", href: "/assurances", num: "05" },
    { label: "Contact", href: "/contact", num: "06" },
];
const authLinks = [
    { label: "Connexion", href: "/connexion", primary: false },
    { label: "Inscription", href: "/inscription", primary: true },
];
const socialLinks = [
    { label: "Instagram", href: "https://instagram.com" },
    { label: "Behance", href: "https://behance.net" },
    { label: "LinkedIn", href: "https://linkedin.com" },
];
---

<div
    id="mobile-menu"
    class="fixed inset-0 z-[200]"
    role="dialog"
    aria-modal="true"
    aria-label="Menu de navigation"
    aria-hidden="true"
>
    <!-- Backdrop -->
    <div
        class="menu-backdrop absolute inset-0 bg-black/50 cursor-pointer"
        aria-hidden="true"
    >
    </div>

    <!-- Panel -->
    <div
        class="menu-panel absolute top-0 right-0 bottom-0 w-full max-w-[420px] bg-[#0c0c0b] flex flex-col p-6 sm:p-8 overflow-y-auto overscroll-contain will-change-transform"
    >
        <!-- Top bar -->
        <div class="flex items-center justify-between mb-12">
            <a
                href="/accueil"
                class="flex items-center"
                aria-label="Oriento – Accueil"
            >
                <img
                    src="/src/assets/img/logo_blanc.avif"
                    alt="Logo Oriento"
                    class="h-8 w-auto"
                    width="120"
                    height="40"
                    loading="eager"
                    decoding="async"
                />
            </a>
            <button
                id="menu-close-btn"
                type="button"
                aria-label="Fermer le menu"
                class="flex items-center justify-center w-11 h-11 -mr-2 text-[#f0efe9] rounded-lg hover:bg-white/[0.08] transition-colors duration-200 cursor-pointer border-none bg-transparent"
            >
                <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                    focusable="false"
                >
                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round"
                    ></path>
                </svg>
            </button>
        </div>

        <!-- Nav -->
        <nav class="mb-8" aria-label="Navigation principale mobile">
            <ul role="list">
                {
                    navLinks.map((link, i) => (
                        <li
                            class="menu-item border-t border-white/[0.08] last:border-b last:border-white/[0.08]"
                            style={`--delay: ${i * 50 + 100}ms`}
                        >
                            <a
                                href={link.href}
                                class="flex items-center gap-4 py-4 text-[#f0efe9] no-underline hover:opacity-60 transition-opacity duration-200"
                                style="font-family:var(--font-display);font-size:clamp(1.5rem,1.2rem + 1.25vw,2.25rem);font-weight:700;letter-spacing:-0.02em;line-height:1;"
                            >
                                <span
                                    class="text-xs font-normal tracking-[0.05em] min-w-[1.8em]"
                                    style="color:rgba(240,239,233,0.35);"
                                    aria-hidden="true"
                                >
                                    {link.num}
                                </span>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>

        <!-- Auth -->
        <div class="flex gap-4 mb-8">
            {
                authLinks.map((link, i) => (
                    <a
                        href={link.href}
                        class={`menu-item inline-flex items-center px-6 py-3 text-sm font-semibold no-underline rounded-full hover:opacity-80 transition-opacity duration-200 ${
                            link.primary
                                ? "bg-[#f0efe9] text-[#0c0c0b] border border-[#f0efe9]"
                                : "text-[#f0efe9] border border-white/20 bg-white/[0.05]"
                        }`}
                        style={`--delay: ${(navLinks.length + i) * 50 + 100}ms`}
                    >
                        {link.label}
                    </a>
                ))
            }
        </div>

        <!-- Divider -->
        <div class="h-px bg-white/[0.08] mb-6" aria-hidden="true"></div>

        <!-- Social + illustration -->
        <div class="flex items-end justify-between gap-4 mt-auto">
            <nav aria-label="Réseaux sociaux">
                <ul role="list" class="flex flex-col gap-2">
                    {
                        socialLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    aria-label={`${link.label} (ouvre dans un nouvel onglet)`}
                                    class="text-sm no-underline hover:text-[#f0efe9] transition-colors duration-200"
                                    style="color:rgba(240,239,233,0.45);"
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>

            <div class="flex-shrink-0" aria-hidden="true">
                <img
                    src="/src/assets/img/Menu_img.avif"
                    alt=""
                    class="h-auto"
                    style="width:clamp(120px,40vw,200px);"
                    width="200"
                    height="160"
                    loading="lazy"
                    decoding="async"
                />
            </div>
        </div>
    </div>
</div>

<script>
    // Bouton fermeture interne
    document.getElementById("menu-close-btn")?.addEventListener("click", () => {
        const toggle = document.getElementById(
            "menu-toggle",
        ) as HTMLButtonElement;
        const menu = document.getElementById("mobile-menu") as HTMLElement;
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.setAttribute("aria-label", "Ouvrir le menu de navigation");
        menu?.setAttribute("aria-hidden", "true");
        menu?.classList.remove("is-open");
        document.body.classList.remove("menu-open");
        toggle?.focus();
    });

    // Focus trap
    const menu = document.getElementById("mobile-menu") as HTMLElement;
    menu?.addEventListener("keydown", (e) => {
        if (!menu.classList.contains("is-open")) return;
        const focusables = menu.querySelectorAll<HTMLElement>(
            "a[href], button:not([disabled])",
        );
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.key === "Tab") {
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        }
    });
</script>
