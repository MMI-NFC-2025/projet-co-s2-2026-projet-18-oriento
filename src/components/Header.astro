---
import logoBlanc from "../assets/Oriento_img/logo_blanc.avif";
import logoNoir from "../assets/Oriento_img/logo_noir.avif";
import menuImg from "../assets/Oriento_img/Menu_img.avif";

interface Props {
    heroSection?: boolean;
}
const { heroSection = false } = Astro.props;
---

<header
    id="site-header"
    role="banner"
    class={`site-header ${heroSection ? "is-hero" : "is-default"}`}
>
    <div class="header-inner">
        <!-- Logo -->
        <a
            href="/"
            aria-label="Oriento — retour à l'accueil"
            class="header-logo"
        >
            <img
                id="logo-blanc"
                src={logoBlanc.src}
                alt="Oriento"
                width="42"
                height="42"
                class="logo-img"
                style={`display:${heroSection ? "block" : "none"}`}
                loading="eager"
                fetchpriority="high"
            />
            <img
                id="logo-noir"
                src={logoNoir.src}
                alt="Oriento"
                width="42"
                height="42"
                class="logo-img"
                style={`display:${heroSection ? "none" : "block"}`}
                loading="eager"
            />
        </a>

        <!-- Nav desktop -->
        <nav
            id="desktop-nav"
            class="desktop-nav"
            role="navigation"
            aria-label="Navigation principale"
        >
            <a href="/etudes" class="nav-lien">Études</a>
            <a href="/logement" class="nav-lien">Logement</a>
            <a href="/assurance" class="nav-lien">Assurance</a>
            <a href="/impots" class="nav-lien">Impôts</a>
            <a href="/a-propos" class="nav-lien">À propos</a>
            <a href="/contact" class="nav-cta">Contact</a>
        </nav>

        <!-- Burger -->
        <button
            id="burger"
            type="button"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="burger"
        >
            <span id="bl1" aria-hidden="true"></span>
            <span id="bl2" aria-hidden="true"></span>
            <span id="bl3" aria-hidden="true"></span>
        </button>
    </div>
</header>

<!-- Spacer -->
<div aria-hidden="true" class="header-spacer"></div>

<!-- ——— MENU MOBILE OVERLAY ——— -->
<div
    id="mobile-menu"
    class="mobile-overlay"
    role="dialog"
    aria-modal="true"
    aria-label="Menu de navigation"
    aria-hidden="true"
>
    <div class="mobile-overlay-inner">
        <!-- Header du menu -->
        <div class="mobile-header">
            <a href="/" class="mobile-logo" aria-label="Oriento — accueil">
                <img
                    src={logoBlanc.src}
                    alt="Oriento"
                    width="42"
                    height="42"
                    class="logo-img"
                    loading="eager"
                />
            </a>
            <button
                id="close-menu"
                type="button"
                aria-label="Fermer le menu"
                class="close-btn"
            >
                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                >
                    <path d="M18 6L6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Liens -->
        <nav class="mobile-nav" aria-label="Menu mobile">
            <a href="/" class="mobile-lien">Accueil</a>
            <a href="/logement" class="mobile-lien">Se loger</a>
            <a href="/impots" class="mobile-lien">Impôts</a>
            <a href="/etudes" class="mobile-lien">Etudes</a>
            <a href="/assurance" class="mobile-lien">Assurances</a>
            <a href="/contact" class="mobile-lien">Contact</a>
            <a href="/a-propos" class="mobile-lien">À propos</a>
            <a href="/connexion" class="mobile-lien">Connexion</a>
            <a href="/inscription" class="mobile-lien">Inscription</a>
        </nav>

        <!-- Réseaux -->
        <div class="mobile-reseaux">
            <a
                href="https://instagram.com"
                class="mobile-reseau"
                target="_blank"
                rel="noopener noreferrer">Instagram</a
            >
            <a
                href="https://behance.net"
                class="mobile-reseau"
                target="_blank"
                rel="noopener noreferrer">Behance</a
            >
            <a
                href="https://linkedin.com"
                class="mobile-reseau"
                target="_blank"
                rel="noopener noreferrer">LinkedIn</a
            >
        </div>

        <!-- Illustration -->
        <div class="mobile-illus">
            <img
                src={menuImg.src}
                alt=""
                aria-hidden="true"
                width="340"
                height="240"
                loading="lazy"
            />
        </div>
    </div>
</div>

<style>
    /* ——— HEADER ——— */
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        transition:
            background-color 0.3s ease,
            box-shadow 0.3s ease;
    }
    .is-hero {
        background-color: #fedc29;
    }
    .is-default {
        background-color: #ffffff;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
    }

    .header-inner {
        max-width: 1152px;
        margin: 0 auto;
        padding: 0 1.25rem;
        height: 5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .header-spacer {
        height: 5rem;
    }

    /* ——— LOGOS ——— */
    .header-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
        flex-shrink: 0;
    }
    .logo-img {
        height: 2.625rem;
        width: auto;
        display: block;
    }

    /* ——— BURGER ——— */
    .burger {
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.25rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        width: 2.5rem;
        height: 2.5rem;
        outline-offset: 4px;
    }
    #bl1,
    #bl2,
    #bl3 {
        display: block;
        width: 1.75rem;
        height: 3px;
        background: #ffffff;
        border-radius: 0;
        transform-origin: center;
        transition:
            transform 0.3s ease,
            opacity 0.3s ease,
            background 0.3s ease;
    }

    /* ——— NAV DESKTOP ——— */
    .desktop-nav {
        display: none;
        align-items: center;
        gap: 2rem;
    }
    .nav-lien {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none;
        color: #171717;
        padding: 0.25rem 0;
        border-bottom: 2px solid transparent;
        transition:
            border-color 0.2s,
            color 0.2s;
    }
    .nav-lien:hover {
        border-bottom-color: #171717;
    }
    .nav-cta {
        display: inline-block;
        background: #171717;
        color: #fedc29;
        font-weight: 900;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.5rem 1.5rem;
        border-radius: 9999px;
        text-decoration: none;
        transition:
            background 0.2s,
            color 0.2s;
    }
    .nav-cta:hover {
        background: #3d60fe;
        color: #ffffff;
    }

    @media (min-width: 768px) {
        .desktop-nav {
            display: flex;
        }
        .burger {
            display: none;
        }
    }

    /* ——— OVERLAY MENU MOBILE ——— */
    .mobile-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: #171717;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }
    .mobile-overlay.is-open {
        opacity: 1;
        pointer-events: all;
    }

    .mobile-overlay-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 0 1.5rem 1.5rem;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
    }
    .mobile-overlay-inner::-webkit-scrollbar {
        display: none;
    }

    .mobile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 5rem;
        flex-shrink: 0;
    }
    .mobile-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    .close-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: #ffffff;
        width: 2.5rem;
        height: 2.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        outline-offset: 4px;
    }
    .close-btn svg {
        width: 28px;
        height: 28px;
    }

    /* ——— LIENS ——— */
    .mobile-nav {
        display: flex;
        flex-direction: column;
        flex: 1;
        justify-content: center;
        gap: 0.1rem;
    }
    .mobile-lien {
        font-family: var(--font-body);
        font-size: var(--text-2xl);
        font-weight: var(--weight-regular);
        color: #ffffff;
        text-decoration: none;
        padding: 0.15rem 0;
        line-height: 1.25;
        transition: color 0.2s;
        display: block;
    }
    .mobile-lien:hover {
        color: #fedc29;
    }

    /* ——— RÉSEAUX ——— */
    .mobile-reseaux {
        display: flex;
        gap: 2rem;
        padding-top: 1rem;
        flex-shrink: 0;
    }
    .mobile-reseau {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        transition: color 0.2s;
    }
    .mobile-reseau:hover {
        color: #ffffff;
    }

    /* ——— ILLUSTRATION ——— */
    .mobile-illus {
        flex-shrink: 0;
        margin-top: 1rem;
        display: flex;
        justify-content: flex-start;
    }
    .mobile-illus img {
        width: auto;
        max-width: 100%;
        height: 160px;
        object-fit: contain;
        object-position: left bottom;
        display: block;
    }

    :focus-visible {
        outline: 2px solid #3d60fe;
        outline-offset: 4px;
        border-radius: 2px;
    }
</style>

<script define:vars={{ heroSection }}>
    const header = document.getElementById("site-header");
    const logoBlanc = document.getElementById("logo-blanc");
    const logoNoir = document.getElementById("logo-noir");
    const desktopNav = document.getElementById("desktop-nav");
    const burger = document.getElementById("burger");
    const mobileMenu = document.getElementById("mobile-menu");
    const closeBtn = document.getElementById("close-menu");
    const bl1 = document.getElementById("bl1");
    const bl2 = document.getElementById("bl2");
    const bl3 = document.getElementById("bl3");

    const mq = window.matchMedia("(min-width: 768px)");
    function applyMq(e) {
        desktopNav.style.display = e.matches ? "flex" : "none";
        burger.style.display = e.matches ? "none" : "flex";
        if (e.matches) closeMobileMenu();
    }
    mq.addEventListener("change", applyMq);
    applyMq(mq);

    function updateScroll() {
        if (!heroSection) return;
        const scrolled = window.scrollY > 60;
        header.style.backgroundColor = scrolled ? "#ffffff" : "#FEDC29";
        header.style.boxShadow = scrolled
            ? "0 1px 6px rgba(0,0,0,0.08)"
            : "none";
        logoBlanc.style.display = scrolled ? "none" : "block";
        logoNoir.style.display = scrolled ? "block" : "none";
        const barColor = scrolled ? "#171717" : "#ffffff";
        bl1.style.background = barColor;
        bl2.style.background = barColor;
        bl3.style.background = barColor;
    }
    if (heroSection) {
        window.addEventListener("scroll", updateScroll, { passive: true });
        updateScroll();
    } else {
        logoBlanc.style.display = "none";
        logoNoir.style.display = "block";
        bl1.style.background = "#171717";
        bl2.style.background = "#171717";
        bl3.style.background = "#171717";
    }

    let savedBarColor = null;

    function openMobileMenu() {
        savedBarColor =
            bl1.style.background || (heroSection ? "#ffffff" : "#171717");
        bl1.style.background = "#ffffff";
        bl2.style.background = "#ffffff";
        bl3.style.background = "#ffffff";
        mobileMenu.classList.add("is-open");
        mobileMenu.setAttribute("aria-hidden", "false");
        burger.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
    }

    function closeMobileMenu() {
        mobileMenu.classList.remove("is-open");
        mobileMenu.setAttribute("aria-hidden", "true");
        burger.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
        if (savedBarColor) {
            bl1.style.background = savedBarColor;
            bl2.style.background = savedBarColor;
            bl3.style.background = savedBarColor;
        }
    }

    burger.addEventListener("click", openMobileMenu);
    closeBtn.addEventListener("click", () => {
        closeMobileMenu();
        burger.focus();
    });
    mobileMenu
        .querySelectorAll("a.mobile-lien")
        .forEach((l) => l.addEventListener("click", closeMobileMenu));
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && mobileMenu.classList.contains("is-open")) {
            closeMobileMenu();
            burger.focus();
        }
    });
</script>
