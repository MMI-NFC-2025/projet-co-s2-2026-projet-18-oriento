---
import Layout from "../../layouts/Layout.astro";
import BoutonConseil from "../../components/BoutonConseil.astro";
import logoCompletBlanc from "../../assets/Oriento_img/logo_complet_blanc.avif";
import Img1 from "../../assets/Oriento_img/logement_logement_img.avif";

type Lien = {
    label: string;
    url: string;
};

type PageData = {
    titre: string;
    intro: string;
    sections: {
        titre: string;
        texte?: string;
        bullets?: string[];
        conseils: string;
        liens?: Lien[];
    }[];
};

const pages: Record<string, PageData> = {
    preparer: {
        titre: "Préparer son dossier de location",
        intro: "Pour louer un logement, vous devrez généralement fournir plusieurs documents au propriétaire ou à l'agence. Préparer votre dossier à l'avance vous permettra de répondre rapidement aux annonces et d'augmenter vos chances d'obtenir le logement.",
        sections: [
            {
                titre: "Pièce d'identité",
                texte: "Carte d'identité, passeport ou titre de séjour valide.",
                conseils:
                    "Scanne ta pièce d'identité en haute résolution et garde-la toujours prête en PDF. Certaines agences refusent les photos floues ou recadrées.",
                liens: [
                    {
                        label: "Service-public.fr — Documents autorisés pour la location",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F1169",
                    },
                ],
            },
            {
                titre: "Justificatif étudiant",
                texte: "Carte étudiante, certificat de scolarité ou attestation d'inscription dans votre établissement.",
                conseils:
                    "Télécharge ton certificat de scolarité depuis ton ENT dès la rentrée. Il est souvent disponible en quelques clics et accepté par tous les bailleurs.",
                liens: [
                    {
                        label: "messervices.etudiant.gouv.fr — Certificat de scolarité",
                        url: "https://www.messervices.etudiant.gouv.fr",
                    },
                ],
            },
            {
                titre: "Justificatif de revenus",
                texte: "Bulletins de salaire, contrat d'alternance, attestation de bourse ou tout document prouvant vos ressources.",
                conseils:
                    "Si tu n'as pas de revenus propres, une attestation de bourse ou une lettre de tes parents indiquant qu'ils prennent en charge ton loyer peut suffire.",
                liens: [
                    {
                        label: "Service-public.fr — Pièces justificatives demandées par le bailleur",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F1169",
                    },
                ],
            },
            {
                titre: "Garant (si demandé)",
                texte: "Un garant peut être demandé pour assurer le paiement du loyer. Il devra fournir :",
                bullets: [
                    "une pièce d'identité",
                    "un justificatif de revenus",
                    "un avis d'imposition",
                ],
                conseils:
                    "Si tu n'as pas de garant physique, tu peux utiliser le dispositif Visale (gratuit, proposé par Action Logement) qui se porte garant à ta place auprès du propriétaire.",
                liens: [
                    {
                        label: "visale.fr — Garantie locative gratuite Visale",
                        url: "https://www.visale.fr",
                    },
                    {
                        label: "Service-public.fr — Se porter garant pour un locataire",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F31267",
                    },
                ],
            },
            {
                titre: "Conseils pratiques",
                bullets: [
                    "Préparez des copies numériques de vos documents",
                    "Regroupez-les dans un seul fichier PDF",
                    "Vérifiez que les documents sont lisibles et à jour",
                ],
                conseils:
                    "Crée un dossier de location sur DossierFacile.fr, le service gratuit de l'État. Il certifie ton dossier et rassure les propriétaires, ce qui peut faire la différence face à d'autres candidats.",
                liens: [
                    {
                        label: "DossierFacile.fr — Dossier de location certifié par l'État",
                        url: "https://www.dossierfacile.logement.gouv.fr",
                    },
                ],
            },
        ],
    },
    bail: {
        titre: "Comprendre son bail de location",
        intro: "Le bail est le contrat qui encadre ta relation avec ton propriétaire. Le lire attentivement avant de signer te protège des mauvaises surprises et te permet de connaître tes droits et obligations.",
        sections: [
            {
                titre: "Les types de bail",
                texte: "Il existe plusieurs types de contrats de location selon le logement :",
                bullets: [
                    "Bail nu (vide) : durée de 3 ans minimum, renouvelable automatiquement",
                    "Bail meublé : durée de 1 an minimum (9 mois pour les étudiants)",
                    "Bail mobilité : entre 1 et 10 mois, non renouvelable, idéal pour les stages ou alternances",
                ],
                conseils:
                    "Pour un logement étudiant, préfère un bail meublé ou mobilité. Ils sont plus courts et plus flexibles si tu changes de ville ou de formation.",
                liens: [
                    {
                        label: "Service-public.fr — Bail meublé étudiant (9 mois)",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F31723",
                    },
                    {
                        label: "Service-public.fr — Bail mobilité",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F34038",
                    },
                ],
            },
            {
                titre: "Les clauses importantes",
                texte: "Certaines mentions dans le bail méritent une attention particulière :",
                bullets: [
                    "Le montant du loyer et des charges (détail des charges incluses ou non)",
                    "Le montant du dépôt de garantie (1 mois pour un meublé, 2 mois pour un bail nu)",
                    "Les conditions de résiliation et le préavis (1 mois en meublé, 3 mois en nu)",
                ],
                conseils:
                    "Tout ce qui n'est pas écrit dans le bail n'a pas de valeur légale. Si ton propriétaire te promet quelque chose verbalement, demande-lui de l'écrire dans le contrat ou dans un avenant.",
                liens: [
                    {
                        label: "Service-public.fr — Contenu obligatoire du bail",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F920",
                    },
                    {
                        label: "ANIL — Dépôt de garantie : règles et restitution",
                        url: "https://www.anil.org/votre-projet/vous-etes-locataire/entree-dans-les-lieux/depot-de-garantie/",
                    },
                ],
            },
            {
                titre: "L'état des lieux",
                texte: "L'état des lieux est un document obligatoire qui décrit l'état du logement à ton entrée et à ta sortie :",
                bullets: [
                    "Il doit être fait contradictoirement (en présence du locataire et du propriétaire)",
                    "Note tous les défauts existants, même mineurs, avec des photos datées",
                    "Un état des lieux incomplet peut te coûter des retenues injustifiées sur ta caution",
                ],
                conseils:
                    "Prends des photos de chaque pièce le jour de l'état des lieux d'entrée et envoie-les par e-mail à ton propriétaire. Elles serviront de preuve en cas de litige à la sortie.",
                liens: [
                    {
                        label: "Service-public.fr — État des lieux d'entrée",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F31269",
                    },
                    {
                        label: "Service-public.fr — État des lieux de sortie",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F31270",
                    },
                ],
            },
            {
                titre: "Tes droits en tant que locataire",
                texte: "La loi te protège en tant que locataire :",
                bullets: [
                    "Le propriétaire ne peut pas entrer dans ton logement sans ton accord",
                    "Il ne peut pas augmenter le loyer en cours de bail sans raison légale",
                    "Tu as droit à un logement décent : chauffage, eau chaude, absence d'humidité excessive",
                ],
                conseils:
                    "En cas de litige avec ton propriétaire, contacte l'ADIL (Agence Départementale d'Information sur le Logement) de ta ville. La consultation est gratuite et les conseils sont juridiquement fiables.",
                liens: [
                    {
                        label: "Service-public.fr — Droits et obligations du locataire",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F1699",
                    },
                    {
                        label: "ANIL — Trouver l'ADIL de votre département",
                        url: "https://www.anil.org/lanil-et-les-adil/votre-adil/",
                    },
                ],
            },
        ],
    },
    aides: {
        titre: "Les aides au logement étudiant",
        intro: "Se loger est souvent le poste de dépense le plus important pour un étudiant. Heureusement, plusieurs aides existent pour alléger cette charge financière. Voici tout ce qu'il faut savoir pour en bénéficier.",
        sections: [
            {
                titre: "L'APL (Aide Personnalisée au Logement)",
                texte: "L'APL est l'aide la plus connue et la plus répandue pour les étudiants :",
                bullets: [
                    "Versée directement par la CAF, souvent déduite automatiquement de ton loyer",
                    "Son montant dépend de tes revenus, de ton loyer et de ta localisation",
                    "Elle est accessible dès ton entrée dans le logement, sans condition d'âge",
                ],
                conseils:
                    "Fais ta demande d'APL sur caf.fr dès que tu signes ton bail. Chaque mois de retard est une aide perdue définitivement.",
                liens: [
                    {
                        label: "CAF.fr — Faire une demande d'aide au logement",
                        url: "https://www.caf.fr/allocataires/droits-et-prestations/s-informer-sur-les-aides/logement-et-cadre-de-vie/l-aide-au-logement",
                    },
                    {
                        label: "Service-public.fr — APL, ALS, ALF : aide au logement étudiant",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F1563",
                    },
                ],
            },
            {
                titre: "Les résidences CROUS",
                texte: "Les résidences universitaires gérées par le CROUS sont une alternative très abordable :",
                bullets: [
                    "Loyers bien inférieurs au marché privé (entre 150 € et 400 € selon la ville et le type de chambre)",
                    "La demande se fait sur trouvermonlogement.etudiant.gouv.fr dès le mois d'avril",
                    "Les boursiers sont prioritaires dans l'attribution des logements",
                ],
                conseils:
                    "Ne compte pas uniquement sur une place en CROUS. Les demandes sont nombreuses et les places limitées. Prépare un plan B avec des logements privés en parallèle.",
                liens: [
                    {
                        label: "trouvermonlogement.etudiant.gouv.fr — Demander un logement CROUS",
                        url: "https://trouvermonlogement.etudiant.gouv.fr",
                    },
                    {
                        label: "messervices.etudiant.gouv.fr — Dossier Social Étudiant (logement)",
                        url: "https://www.messervices.etudiant.gouv.fr",
                    },
                ],
            },
            {
                titre: "Le dispositif Visale",
                texte: "Visale est une garantie locative gratuite proposée par Action Logement :",
                bullets: [
                    "Il se porte garant à ta place auprès du propriétaire",
                    "Accessible aux étudiants de moins de 30 ans sans condition de revenus",
                    "La demande se fait en ligne sur visale.fr en quelques minutes",
                ],
                conseils:
                    "Obtiens ton visa Visale avant même de commencer à chercher un logement. Certains propriétaires l'acceptent plus facilement qu'un garant physique.",
                liens: [
                    {
                        label: "visale.fr — Obtenir sa garantie Visale",
                        url: "https://www.visale.fr",
                    },
                    {
                        label: "Service-public.fr — Visale, caution locative étudiante",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F34002",
                    },
                ],
            },
            {
                titre: "Autres aides disponibles",
                texte: "D'autres dispositifs peuvent compléter tes ressources :",
                bullets: [
                    "La caution Locapass d'Action Logement pour financer ton dépôt de garantie",
                    "Les aides régionales au logement étudiant selon ta région",
                    "Les aides d'urgence du CROUS en cas de difficultés financières imprévues",
                ],
                conseils:
                    "Consulte le site de ta région et de ton CROUS local. Beaucoup d'aides sont peu connues et donc peu demandées, ce qui augmente tes chances de les obtenir.",
                liens: [
                    {
                        label: "actionlogement.fr — Locapass et aides au logement",
                        url: "https://www.actionlogement.fr/le-locapass",
                    },
                    {
                        label: "Service-public.fr — Aides d'urgence CROUS",
                        url: "https://www.service-public.fr/particuliers/vosdroits/F1024",
                    },
                    {
                        label: "1jeune1solution.gouv.fr — Aides logement jeunes",
                        url: "https://www.1jeune1solution.gouv.fr/logement",
                    },
                ],
            },
        ],
    },
};

const slug = Astro.params.slug;
const page = pages[slug as keyof typeof pages];
---

<Layout title={`${page.titre} — Oriento`} heroSection={true}>
    <div class="page-wrapper">
        <section class="hero-section" aria-label="Présentation">
            <div class="hero-inner">
                <div class="hero-logo-wrap">
                    <img
                        src={logoCompletBlanc.src}
                        alt="Oriento"
                        width="800"
                        height="250"
                        class="hero-logo-img"
                        loading="eager"
                        fetchpriority="high"
                    />
                </div>
                <div class="hero-texte">
                    <p>Trouver un logement</p>
                    <div class="hero-img-wrap">
                        <img
                            src={Img1.src}
                            alt="Illustration logement"
                            width="900"
                            height="600"
                            class="hero-img"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                </div>
            </div>
        </section>

        <section class="intro-section" aria-label="Introduction">
            <div class="intro-inner">
                <h1 class="intro-h1">{page.titre}</h1>
                <p class="intro-texte">{page.intro}</p>
            </div>
        </section>

        <section class="cards-section" aria-label="Contenu">
            <div class="cards-grid">
                {
                    page.sections.map((s) => (
                        <div class="card">
                            <h3 class="card-titre">{s.titre}</h3>
                            {s.texte && <p class="card-texte">{s.texte}</p>}
                            {s.bullets && s.bullets.length > 0 && (
                                <ul class="card-bullets">
                                    {s.bullets.map((b) => (
                                        <li>{b}</li>
                                    ))}
                                </ul>
                            )}
                            <BoutonConseil conseils={s.conseils} />
                            {s.liens && s.liens.length > 0 && (
                                <div class="card-liens">
                                    <p class="card-liens-titre">
                                        Sources officielles
                                    </p>
                                    <ul class="card-liens-liste">
                                        {s.liens.map((lien) => (
                                            <li>
                                                <a
                                                    href={lien.url}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="card-lien"
                                                >
                                                    <svg
                                                        viewBox="0 0 16 16"
                                                        fill="none"
                                                        aria-hidden="true"
                                                        class="lien-icon"
                                                    >
                                                        <path
                                                            d="M6 3H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-3"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                        />
                                                        <path
                                                            d="M9 2h5v5"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                        />
                                                        <path
                                                            d="M14 2 8 8"
                                                            stroke="currentColor"
                                                            stroke-width="1.5"
                                                            stroke-linecap="round"
                                                        />
                                                    </svg>
                                                    {lien.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    <style>
        .page-wrapper {
            background: var(--color-blue-light);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* HERO */
        .hero-section {
            background: var(--color-yellow);
            display: flex;
            align-items: stretch;
        }
        .hero-inner {
            width: 100%;
            max-width: 1152px;
            margin: 0 auto;
            padding: var(--space-l) var(--space-sm);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            gap: var(--space-sm);
        }
        .hero-logo-wrap {
            width: 100%;
            display: flex;
            justify-content: flex-start;
        }
        .hero-logo-img {
            height: clamp(6rem, 28vw, 9rem);
            width: auto;
        }
        .hero-img-wrap {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: flex-end;
        }
        .hero-img {
            width: 100%;
            max-width: 480px;
            height: auto;
            object-fit: contain;
            object-position: bottom;
        }
        .hero-texte {
            width: 100%;
            padding: var(--space-m) 0;
        }
        .hero-texte p {
            font-family: var(--font-body);
            font-size: var(--text-5xl);
            font-weight: var(--weight-bold);
            color: var(--color-dark);
            line-height: 1.1;
        }

        /* INTRO */
        .intro-section {
            padding: var(--space-2xl) var(--space-sm) var(--space-l);
        }
        .intro-inner {
            max-width: 960px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
        }
        .intro-h1 {
            font-family: var(--font-body);
            font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl));
            font-weight: var(--weight-black);
            color: var(--color-white);
            line-height: 1.1;
            -webkit-font-smoothing: auto;
        }
        .intro-texte {
            font-family: var(--font-body);
            font-size: clamp(var(--text-sm), 2.5vw, var(--text-m));
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.7;
        }

        /* CARDS GRID */
        .cards-section {
            padding: var(--space-l) var(--space-sm) var(--space-3xl);
        }
        .cards-grid {
            max-width: 960px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr;
            gap: var(--space-m);
            width: 100%;
        }
        .card {
            background: var(--color-dark-blue);
            border-radius: var(--radius-m);
            padding: var(--space-l);
            display: flex;
            flex-direction: column;
            gap: var(--space-m);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
            min-width: 0;
            overflow: hidden;
        }
        .card-titre {
            font-family: var(--font-body);
            font-size: var(--text-m);
            font-weight: var(--weight-bold);
            color: var(--color-white);
            -webkit-font-smoothing: auto;
        }
        .card-texte {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-bold);
            color: var(--color-white);
            line-height: 1.6;
        }
        .card-bullets {
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
            padding-left: var(--space-m);
            margin: 0;
        }
        .card-bullets li {
            font-family: var(--font-body);
            font-size: var(--text-sm);
            font-weight: var(--weight-regular, 400);
            color: var(--color-white);
            line-height: 1.5;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        /* LIENS OFFICIELS */
        .card-liens {
            border-top: 1px solid rgba(255, 255, 255, 0.12);
            padding-top: var(--space-m);
            display: flex;
            flex-direction: column;
            gap: var(--space-s);
        }
        .card-liens-titre {
            font-family: var(--font-body);
            font-size: var(--text-xs);
            font-weight: var(--weight-bold);
            color: rgba(255, 255, 255, 0.5);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin: 0;
        }
        .card-liens-liste {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: var(--space-xs);
        }
        .card-lien {
            display: inline-flex;
            align-items: center;
            gap: var(--space-xs);
            font-family: var(--font-body);
            font-size: var(--text-sm);
            color: var(--color-yellow);
            text-decoration: none;
            font-weight: var(--weight-medium);
            transition: opacity 0.15s;
            word-break: break-word;
        }
        .card-lien:hover {
            opacity: 0.75;
            text-decoration: underline;
        }
        .lien-icon {
            width: 13px;
            height: 13px;
            flex-shrink: 0;
            opacity: 0.8;
        }

        @media (min-width: 640px) {
            .cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        @media (min-width: 768px) {
            .hero-logo-wrap {
                justify-content: center;
            }
            .hero-logo-img {
                height: clamp(5rem, 12vw, 9rem);
            }
            .hero-img {
                max-width: 100%;
            }
            .hero-texte p {
                font-size: 7rem;
            }
        }
    </style>
</Layout>
